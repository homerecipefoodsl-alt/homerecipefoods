rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Core Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidEmailId(emailId) {
      return emailId is string
        && emailId.size() >= 3
        && emailId.size() <= 254
        && emailId.matches('^[a-z0-9._%+\\-]+@[a-z0-9.\\-]+\\.[a-z]{2,}$');
    }

    function isValidChatSessionId(id) {
      return id is string && id.size() >= 24 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidSlug(slug) {
      return slug is string && slug.size() >= 1 && slug.size() <= 160 && slug.matches('^[a-z0-9\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function hasVerifiedEmail() {
      return isSignedIn()
        && ('email_verified' in request.auth.token)
        && request.auth.token.email_verified == true
        && ('email' in request.auth.token)
        && request.auth.token.email is string;
    }

    function authEmail() {
      return request.auth.token.email.trim().lower();
    }

    function adminDoc() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid)).data;
    }

    function rbacDoc() {
      return get(/databases/$(database)/documents/rbac_roles/$(authEmail())).data;
    }

    function rbacRole() {
      return rbacDoc().role;
    }

    function isAdminRecordActive(d) {
      return (!('uid' in d) || (d.uid is string && d.uid == request.auth.uid))
        && (!('email' in d) || (d.email is string && d.email.trim().lower() == authEmail()))
        && (('active' in d && d.active == true)
          || ('isActive' in d && d.isActive == true)
          || ('status' in d && d.status == 'active'))
        && !('active' in d && d.active == false)
        && !('isActive' in d && d.isActive == false)
        && !('status' in d && d.status in ['disabled', 'suspended', 'inactive', 'revoked'])
        && ('role' in d)
        && d.role in ['primary_super_admin', 'super_admin', 'admin', 'manager', 'editor', 'moderator', 'support_agent'];
    }

    function isRbacRecordActive(d) {
      return (!('email' in d) || (d.email is string && d.email.trim().lower() == authEmail()))
        && ('status' in d)
        && d.status == 'active'
        && ('role' in d)
        && d.role in ['primary_super_admin', 'super_admin', 'admin', 'manager', 'editor', 'moderator', 'support_agent'];
    }

    function hasRolePermission(d, perm) {
      return d.role in ['primary_super_admin', 'super_admin']
        || ('permissions' in d && d.permissions is list && perm in d.permissions)
        || (!('permissions' in d) && d.role == 'admin' && perm in [
          'dashboard_view', 'products_view', 'products_add', 'products_edit', 'products_delete',
          'categories_manage', 'showrooms_manage', 'banners_manage', 'recruitment_manage', 'reports_view'
        ])
        || (!('permissions' in d) && d.role == 'manager' && perm in [
          'dashboard_view', 'products_view', 'products_add', 'products_edit',
          'categories_manage', 'showrooms_manage', 'complaints_manage', 'recruitment_manage', 'reports_view'
        ])
        || (!('permissions' in d) && d.role == 'editor' && perm in [
          'dashboard_view', 'products_view', 'products_add', 'products_edit',
          'categories_manage', 'showrooms_manage', 'banners_manage', 'seo_manage'
        ])
        || (!('permissions' in d) && d.role == 'moderator' && perm in [
          'dashboard_view', 'complaints_manage', 'chat_manage', 'recruitment_manage', 'reports_view'
        ])
        || (!('permissions' in d) && d.role == 'support_agent' && perm in [
          'dashboard_view', 'complaints_manage', 'chat_manage'
        ]);
    }

    // Primary Authoritative RBAC lookup in Firestore (/admins/{uid})
    function hasActiveAdminDoc() {
      return hasVerifiedEmail()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && isAdminRecordActive(adminDoc());
    }

    // Legacy/Fallback RBAC role lookup in Firestore (/rbac_roles/{email})
    // Used ONLY when /admins/{uid} does not exist
    function hasActiveRbacDoc() {
      return hasVerifiedEmail()
        && !exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && exists(/databases/$(database)/documents/rbac_roles/$(authEmail()))
        && isRbacRecordActive(rbacDoc());
    }

    function hasAnyActiveStaffDoc() {
      return hasActiveAdminDoc() || hasActiveRbacDoc();
    }

    function currentStaffRole() {
      return hasActiveAdminDoc() ? adminDoc().role : rbacRole();
    }

    // Primary Super Admin gate: verified email + active Super Admin authority record in Firestore
    function isPrimarySuperAdmin() {
      return hasVerifiedEmail()
        && authEmail() == 'mdmahmudulhashan0@gmail.com'
        && (
          (hasActiveAdminDoc() && adminDoc().role in ['primary_super_admin', 'super_admin'])
          || (hasActiveRbacDoc() && rbacRole() in ['primary_super_admin', 'super_admin'])
        );
    }

    function isSuperAdmin() {
      return (hasActiveAdminDoc() && adminDoc().role in ['primary_super_admin', 'super_admin'])
        || (hasActiveRbacDoc() && rbacRole() in ['primary_super_admin', 'super_admin']);
    }

    function hasPermission(perm) {
      return hasVerifiedEmail() && (
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid))
          && isAdminRecordActive(adminDoc())
          && hasRolePermission(adminDoc(), perm))
        || (!exists(/databases/$(database)/documents/admins/$(request.auth.uid))
          && exists(/databases/$(database)/documents/rbac_roles/$(authEmail()))
          && isRbacRecordActive(rbacDoc())
          && hasRolePermission(rbacDoc(), perm))
      );
    }

    function hasCatalogWritePerm(perm) {
      return hasVerifiedEmail() && (
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid))
          && adminDoc().get('active', false) == true
          && adminDoc().get('isActive', true) != false
          && !(adminDoc().get('status', '') in ['disabled', 'suspended', 'inactive', 'revoked'])
          && adminDoc().get('email', authEmail()).trim().lower() == authEmail()
          && (adminDoc().role in ['primary_super_admin', 'super_admin']
            || (adminDoc().role in ['admin', 'manager', 'editor']
              && perm in adminDoc().get('permissions', ['products_add', 'products_edit', 'categories_manage']))))
        || (!exists(/databases/$(database)/documents/admins/$(request.auth.uid))
          && exists(/databases/$(database)/documents/rbac_roles/$(authEmail()))
          && rbacDoc().get('status', '') == 'active'
          && rbacDoc().get('email', authEmail()).trim().lower() == authEmail()
          && (rbacDoc().role in ['primary_super_admin', 'super_admin']
            || (rbacDoc().role in ['admin', 'manager', 'editor']
              && perm in rbacDoc().get('permissions', ['products_add', 'products_edit', 'categories_manage']))))
      );
    }

    function isCatalogAdmin() {
      return (hasActiveAdminDoc() && adminDoc().role in ['primary_super_admin', 'super_admin', 'admin', 'manager', 'editor'])
        || (hasActiveRbacDoc() && rbacRole() in ['primary_super_admin', 'super_admin', 'admin', 'manager', 'editor']);
    }

    function isSupportAgent() {
      return (hasActiveAdminDoc() && adminDoc().role == 'support_agent')
        || (hasActiveRbacDoc() && rbacRole() == 'support_agent');
    }

    function isSupportStaff() {
      return hasPermission('complaints_manage') || hasPermission('chat_manage');
    }

    function isRecruitmentStaff() {
      return hasPermission('recruitment_manage')
        || (hasActiveAdminDoc() && adminDoc().role == 'admin')
        || (hasActiveRbacDoc() && rbacRole() == 'admin');
    }

    function isBoundedStringList(arr, maxLen, maxItemLen) {
      return arr is list
        && arr.size() <= maxLen
        && (arr.size() == 0 || (arr[0] is string && arr[0].size() <= maxItemLen));
    }

    // Entity Validators
    function isValidRbacRole(data) {
      return data.keys().hasAll(['email', 'uid', 'displayName', 'role', 'status', 'addedByEmail', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'email', 'uid', 'username', 'name', 'displayName', 'phone', 'managerId', 'managerTitle',
          'permissions', 'role', 'status', 'addedByEmail', 'createdBy', 'createdAt', 'updatedAt', 'lastLoginAt'
        ])
        && isValidEmailId(data.email)
        && data.uid is string && data.uid.size() <= 128
        && (!('username' in data) || (data.username is string && data.username.size() <= 64))
        && (!('name' in data) || (data.name is string && data.name.size() <= 120))
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 40))
        && (!('managerId' in data) || (data.managerId is string && data.managerId.size() <= 64))
        && (!('managerTitle' in data) || (data.managerTitle is string && data.managerTitle.size() <= 100))
        && (!('permissions' in data) || isBoundedStringList(data.permissions, 25, 64))
        && data.role in ['primary_super_admin', 'super_admin', 'admin', 'manager', 'editor', 'moderator', 'support_agent']
        && data.status in ['active', 'disabled', 'suspended']
        && data.addedByEmail is string && data.addedByEmail.size() <= 254
        && (!('createdBy' in data) || (data.createdBy is string && data.createdBy.size() <= 254))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && (!('lastLoginAt' in data) || data.lastLoginAt is timestamp);
    }

    function isValidAdminUsername(data) {
      return data.keys().hasAll(['username', 'email', 'active', 'updatedAt'])
        && data.keys().hasOnly(['username', 'email', 'active', 'updatedAt'])
        && isValidId(data.username)
        && isValidEmailId(data.email)
        && data.active is bool
        && data.updatedAt is timestamp;
    }

    function isValidUserAccount(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'photoUrl', 'role', 'status', 'createdAt', 'updatedAt', 'lastLoginAt'])
        && data.keys().hasOnly([
          'uid', 'email', 'name', 'displayName', 'photoUrl', 'phone', 'managerId',
          'permissions', 'role', 'status', 'createdBy', 'createdAt', 'updatedAt', 'lastLoginAt'
        ])
        && isValidId(data.uid)
        && isValidEmailId(data.email)
        && (!('name' in data) || (data.name is string && data.name.size() <= 120))
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && data.photoUrl is string && data.photoUrl.size() <= 500
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 40))
        && (!('managerId' in data) || (data.managerId is string && data.managerId.size() <= 64))
        && (!('permissions' in data) || isBoundedStringList(data.permissions, 25, 64))
        && data.role in ['primary_super_admin', 'super_admin', 'admin', 'manager', 'editor', 'moderator', 'support_agent', 'customer']
        && data.status in ['active', 'disabled', 'suspended']
        && (!('createdBy' in data) || (data.createdBy is string && data.createdBy.size() <= 254))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.lastLoginAt is timestamp;
    }

    function isValidAdminRecord(data) {
      return (
        data.keys().hasAll(['uid', 'email', 'username', 'display_name', 'role', 'active', 'created_at', 'updated_at'])
        && data.keys().hasOnly([
          'uid', 'email', 'username', 'name', 'display_name', 'phone', 'manager_id', 'manager_title',
          'permissions', 'role', 'active', 'isActive', 'status', 'created_by', 'created_at', 'updated_at', 'last_login_at'
        ])
        && isValidId(data.uid)
        && isValidEmailId(data.email)
        && data.username is string && data.username.size() <= 64
        && (!('name' in data) || (data.name is string && data.name.size() <= 120))
        && data.display_name is string && data.display_name.size() >= 1 && data.display_name.size() <= 120
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 40))
        && (!('manager_id' in data) || (data.manager_id is string && data.manager_id.size() <= 64))
        && (!('manager_title' in data) || (data.manager_title is string && data.manager_title.size() <= 100))
        && (!('permissions' in data) || isBoundedStringList(data.permissions, 25, 64))
        && data.role in ['primary_super_admin', 'super_admin', 'admin', 'manager', 'editor', 'moderator', 'support_agent']
        && data.active is bool
        && (!('isActive' in data) || data.isActive is bool)
        && (!('status' in data) || data.status in ['active', 'disabled', 'suspended'])
        && (!('created_by' in data) || (data.created_by is string && data.created_by.size() <= 254))
        && data.created_at is timestamp
        && data.updated_at is timestamp
        && (!('last_login_at' in data) || data.last_login_at is timestamp)
      ) || (
        data.keys().hasAll(['uid', 'email', 'displayName', 'role', 'isOnline', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'isOnline', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && data.role in ['primary_super_admin', 'super_admin', 'admin', 'manager', 'editor', 'moderator', 'support_agent']
        && data.isOnline is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
      );
    }

    function isValidCategory(data) {
      return data.keys().hasAll(['id', 'name', 'nameEn', 'slug', 'description', 'image', 'order', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'id', 'name', 'nameEn', 'name_bn', 'name_en', 'slug', 'icon',
          'description', 'descriptionEn', 'description_bn', 'description_en',
          'image', 'order', 'visible', 'active', 'deleted', 'archivedAt', 'seoTitle', 'seoDescription',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.nameEn is string && data.nameEn.size() >= 1 && data.nameEn.size() <= 120
        && data.get('name_bn', '') is string && data.get('name_bn', '').size() <= 120
        && data.get('name_en', '') is string && data.get('name_en', '').size() <= 120
        && isValidSlug(data.slug)
        && data.get('icon', '') is string && data.get('icon', '').size() <= 40
        && data.description is string && data.description.size() >= 1 && data.description.size() <= 600
        && data.get('descriptionEn', '') is string && data.get('descriptionEn', '').size() <= 600
        && data.get('description_bn', '') is string && data.get('description_bn', '').size() <= 600
        && data.get('description_en', '') is string && data.get('description_en', '').size() <= 600
        && data.image is string && data.image.size() >= 1 && data.image.size() <= 500000
        && data.order is int && data.order >= 0 && data.order <= 1000
        && data.get('visible', true) is bool
        && data.get('active', true) is bool
        && data.get('deleted', false) is bool
        && data.get('seoTitle', '') is string && data.get('seoTitle', '').size() <= 200
        && data.get('seoDescription', '') is string && data.get('seoDescription', '').size() <= 400
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidOccasion(data) {
      return data.keys().hasAll(['id', 'name', 'nameEn', 'slug', 'icon', 'description', 'order', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'id', 'name', 'nameEn', 'name_bn', 'name_en', 'slug', 'icon',
          'description', 'descriptionEn', 'description_bn', 'description_en',
          'order', 'visible', 'deleted', 'archivedAt', 'seoTitle', 'seoDescription',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.nameEn is string && data.nameEn.size() >= 1 && data.nameEn.size() <= 120
        && (!('name_bn' in data) || (data.name_bn is string && data.name_bn.size() <= 120))
        && (!('name_en' in data) || (data.name_en is string && data.name_en.size() <= 120))
        && isValidSlug(data.slug)
        && data.icon is string && data.icon.size() >= 1 && data.icon.size() <= 32
        && data.description is string && data.description.size() >= 1 && data.description.size() <= 600
        && (!('descriptionEn' in data) || (data.descriptionEn is string && data.descriptionEn.size() <= 600))
        && (!('description_bn' in data) || (data.description_bn is string && data.description_bn.size() <= 600))
        && (!('description_en' in data) || (data.description_en is string && data.description_en.size() <= 600))
        && data.order is int && data.order >= 0 && data.order <= 1000
        && (!('visible' in data) || data.visible is bool)
        && (!('deleted' in data) || data.deleted is bool)
        && (!('seoTitle' in data) || (data.seoTitle is string && data.seoTitle.size() <= 200))
        && (!('seoDescription' in data) || (data.seoDescription is string && data.seoDescription.size() <= 400))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function hasOnlyProductKeys(keys) {
      return keys.removeAll([
          'id', 'name', 'nameBn', 'nameEn', 'name_bn', 'name_en', 'slug',
          'category', 'categorySlug', 'categoryName', 'categoryNameEn', 'productType',
          'price', 'old_price', 'discount', 'price_label', 'priceUnit', 'unit',
          'shortDescription', 'shortDescriptionEn', 'short_description_bn', 'short_description_en',
          'description', 'descriptionEn', 'description_bn', 'description_en',
          'image', 'imageUrl'
        ]).removeAll([
          'imageKey', 'images', 'masterKey', 'rating', 'stock', 'sku',
          'ingredients', 'ingredients_bn', 'ingredients_en', 'sizes', 'weight', 'occasions', 'showrooms',
          'availability', 'importantNotes', 'featured', 'popular',
          'visible', 'active', 'isActive', 'deleted', 'status', 'display_order', 'archivedAt',
          'seoTitle', 'seoDescription', 'seoImage',
          'createdBy', 'updatedBy', 'createdAt', 'updatedAt'
        ]).size() == 0;
    }

    function isValidProductCore(data) {
      return data.keys().hasAll([
          'id', 'name', 'nameEn', 'slug', 'category', 'categoryName', 'productType',
          'price', 'priceUnit', 'shortDescription', 'description', 'images', 'ingredients',
          'sizes', 'weight', 'occasions', 'showrooms', 'availability', 'importantNotes',
          'featured', 'popular', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 160
        && data.nameEn is string && data.nameEn.size() >= 1 && data.nameEn.size() <= 160
        && isValidSlug(data.slug)
        && isValidSlug(data.category)
        && data.categoryName is string && data.categoryName.size() >= 1 && data.categoryName.size() <= 120
        && data.productType is string && data.productType.size() >= 1 && data.productType.size() <= 120
        && data.price is number && data.price >= 0 && data.price <= 1000000
        && (!('old_price' in data) || (data.old_price is number && data.old_price >= 0 && data.old_price <= 1000000))
        && data.priceUnit is string && data.priceUnit.size() >= 1 && data.priceUnit.size() <= 60;
    }

    function isValidProductDetails(data) {
      return data.shortDescription is string && data.shortDescription.size() >= 1 && data.shortDescription.size() <= 300
        && data.description is string && data.description.size() >= 1 && data.description.size() <= 4000
        && (!('image' in data) || (data.image is string && data.image.size() <= 400000))
        && (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 400000))
        && (!('imageKey' in data) || (data.imageKey is string && data.imageKey.size() <= 320))
        && isBoundedStringList(data.images, 6, 400000)
        && (!('rating' in data) || (data.rating is number && data.rating >= 0 && data.rating <= 5))
        && (!('stock' in data) || (data.stock is int && data.stock >= 0 && data.stock <= 1000000))
        && data.ingredients is list && data.ingredients.size() <= 25
        && data.sizes is list && data.sizes.size() <= 10
        && data.weight is string && data.weight.size() <= 80
        && data.occasions is list && data.occasions.size() <= 15
        && data.showrooms is list && data.showrooms.size() <= 20;
    }

    function isValidProductMeta(data) {
      return data.availability in ['In Showroom', 'Pre-Order at Showroom', 'Seasonal', 'Out of Stock']
        && data.importantNotes is string && data.importantNotes.size() <= 800
        && data.featured is bool
        && data.popular is bool
        && data.get('visible', true) is bool
        && data.get('active', true) is bool
        && data.get('isActive', true) is bool
        && data.get('deleted', false) is bool
        && data.get('status', 'published') in ['draft', 'published', 'archived']
        && (!('display_order' in data) || (data.display_order is int && data.display_order >= 0 && data.display_order <= 10000))
        && (!('seoImage' in data) || (data.seoImage is string && data.seoImage.size() <= 400000))
        && (!('createdBy' in data) || (data.createdBy is string && data.createdBy.size() <= 254))
        && (!('updatedBy' in data) || (data.updatedBy is string && data.updatedBy.size() <= 254))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidProduct(data) {
      return isValidProductCore(data)
        && data.keys().hasOnly([
          'id', 'name', 'nameBn', 'nameEn', 'name_bn', 'name_en', 'slug',
          'category', 'categorySlug', 'categoryName', 'categoryNameEn', 'productType',
          'price', 'old_price', 'discount', 'price_label', 'priceUnit', 'unit',
          'shortDescription', 'shortDescriptionEn', 'short_description_bn', 'short_description_en',
          'description', 'descriptionEn', 'description_bn', 'description_en',
          'image', 'imageUrl', 'imageKey', 'images', 'masterKey', 'rating', 'stock', 'sku',
          'ingredients', 'ingredients_bn', 'ingredients_en', 'sizes', 'weight', 'occasions', 'showrooms',
          'availability', 'importantNotes', 'featured', 'popular',
          'visible', 'active', 'isActive', 'deleted', 'status', 'display_order', 'archivedAt',
          'seoTitle', 'seoDescription', 'seoImage',
          'createdBy', 'updatedBy', 'createdAt', 'updatedAt'
        ])
        && isValidProductDetails(data)
        && isValidProductMeta(data);
    }

    function isValidShowroom(data) {
      return data.keys().hasAll(['id', 'name', 'area', 'address', 'phone', 'openingHours', 'mapUrl', 'lat', 'lng', 'isMain', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'id', 'name', 'nameEn', 'name_bn', 'name_en',
          'area', 'areaEn', 'address', 'addressEn', 'address_bn', 'address_en',
          'description', 'descriptionEn', 'description_bn', 'description_en',
          'phone', 'alternate_phone', 'email',
          'openingHours', 'openingHoursEn', 'opening_time', 'closing_time', 'weekly_holiday',
          'region', 'orderLineEn', 'orderLineBn',
          'mapUrl', 'lat', 'lng', 'images', 'available_categories', 'available_products',
          'isMain', 'visible', 'deleted', 'display_order', 'archivedAt', 'seoTitle', 'seoDescription',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 140
        && (!('nameEn' in data) || (data.nameEn is string && data.nameEn.size() <= 140))
        && (!('name_bn' in data) || (data.name_bn is string && data.name_bn.size() <= 140))
        && (!('name_en' in data) || (data.name_en is string && data.name_en.size() <= 140))
        && data.area is string && data.area.size() >= 1 && data.area.size() <= 100
        && (!('areaEn' in data) || (data.areaEn is string && data.areaEn.size() <= 100))
        && data.address is string && data.address.size() >= 1 && data.address.size() <= 400
        && (!('addressEn' in data) || (data.addressEn is string && data.addressEn.size() <= 400))
        && (!('address_bn' in data) || (data.address_bn is string && data.address_bn.size() <= 400))
        && (!('address_en' in data) || (data.address_en is string && data.address_en.size() <= 400))
        && (!('description' in data) || (data.description is string && data.description.size() <= 600))
        && (!('descriptionEn' in data) || (data.descriptionEn is string && data.descriptionEn.size() <= 600))
