    function isValidSiteSettings(data) {
      return data.keys().hasAll([
          'brandName', 'tagline', 'supportOnline', 'supportPhone',
          'messengerUrl', 'facebookUrl', 'instagramUrl', 'youtubeUrl', 'heroSlides', 'updatedAt'
        ])
        && data.keys().hasOnly([
