          || ((!('id' in existing()) || !isValidId(existing().id)) && incoming().id == showroomId)
        )
        && incoming().updatedAt == request.time
        && (
          ('createdAt' in existing()
            && existing().createdAt is timestamp
            && incoming().createdAt == existing().createdAt
            && incoming().diff(existing()).addedKeys().hasOnly([
