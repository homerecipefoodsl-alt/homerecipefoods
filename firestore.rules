              'area', 'areaEn', 'address', 'addressEn', 'address_bn', 'address_en',
              'description', 'descriptionEn', 'description_bn', 'description_en',
              'phone', 'alternate_phone', 'email',
              'openingHours', 'openingHoursEn', 'opening_time', 'closing_time', 'weekly_holiday',
              'region', 'orderLineEn', 'orderLineBn',
              'mapUrl', 'lat', 'lng', 'images', 'available_categories', 'available_products',
              'isMain', 'visible', 'deleted', 'display_order', 'archivedAt', 'seoTitle', 'seoDescription',
              'updatedAt'
            ]))
          ||
          ((!('createdAt' in existing()) || !(existing().createdAt is timestamp))
            && incoming().createdAt == request.time
            && incoming().diff(existing()).addedKeys().hasOnly([
              'id', 'name', 'nameEn', 'name_bn', 'name_en',
              'area', 'areaEn', 'address', 'addressEn', 'address_bn', 'address_en',
              'description', 'descriptionEn', 'description_bn', 'description_en',
              'phone', 'alternate_phone', 'email',
              'openingHours', 'openingHoursEn', 'opening_time', 'closing_time', 'weekly_holiday',
              'region', 'orderLineEn', 'orderLineBn',
              'mapUrl', 'lat', 'lng', 'images', 'available_categories', 'available_products',
              'isMain', 'visible', 'deleted', 'display_order', 'archivedAt', 'seoTitle', 'seoDescription',
              'createdAt', 'updatedAt'
            ])
            && incoming().diff(existing()).changedKeys().hasOnly([
              'id', 'name', 'nameEn', 'name_bn', 'name_en',
              'area', 'areaEn', 'address', 'addressEn', 'address_bn', 'address_en',
              'description', 'descriptionEn', 'description_bn', 'description_en',
              'phone', 'alternate_phone', 'email',
              'openingHours', 'openingHoursEn', 'opening_time', 'closing_time', 'weekly_holiday',
              'region', 'orderLineEn', 'orderLineBn',
              'mapUrl', 'lat', 'lng', 'images', 'available_categories', 'available_products',
              'isMain', 'visible', 'deleted', 'display_order', 'archivedAt', 'seoTitle', 'seoDescription',
              'createdAt', 'updatedAt'
            ]))
        );
      allow delete: if hasPermission('showrooms_manage') && isValidId(showroomId);
    }

    match /greetings/{greetingId} {
      allow get: if isValidId(greetingId);
      allow list: if true;
      allow create: if hasPermission('banners_manage')
        && isValidId(greetingId)
        && ((greetingId == 'daily' && isValidGreeting(incoming()))
          || (greetingId != 'daily' && isValidGreetingItem(incoming())))
        && incoming().updatedAt == request.time;
      allow update: if hasPermission('banners_manage')
        && isValidId(greetingId)
        && incoming().updatedAt == request.time
        && (
          (greetingId == 'daily' && isValidGreeting(incoming())
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'useDynamicDate', 'customDateText', 'customDateTextEn',
              'greetingText', 'greetingTextEn', 'greeting_bn', 'greeting_en',
              'dailyMessage', 'dailyMessageEn', 'message_bn', 'message_en',
              'specialMessage', 'specialMessageEn', 'special_message_bn', 'special_message_en',
              'announcement', 'announcementEn', 'announcement_bn', 'announcement_en',
              'updatedAt'
            ]))
          ||
          (greetingId != 'daily' && isValidGreetingItem(incoming())
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'text_bn', 'text_en', 'type', 'active', 'visible', 'display_order',
              'durationMs', 'startDate', 'endDate', 'deleted', 'updatedAt'
            ]))
        );
      allow delete: if hasPermission('banners_manage') && isValidId(greetingId) && greetingId != 'daily';
    }

    match /hero_banners/{bannerId} {
      allow get: if isValidId(bannerId);
      allow list: if true;
      allow create: if hasPermission('banners_manage')
        && isValidId(bannerId)
        && isValidHeroBanner(incoming())
        && incoming().id == bannerId
        && incoming().updatedAt == request.time;
      allow update: if hasPermission('banners_manage')
        && isValidId(bannerId)
        && isValidHeroBanner(incoming())
        && incoming().id == existing().id
        && incoming().updatedAt == request.time;
      allow delete: if hasPermission('banners_manage') && isValidId(bannerId);
    }

    match /homepage_sections/{sectionId} {
      allow get: if isValidId(sectionId);
      allow list: if true;
      allow create: if hasPermission('banners_manage')
        && isValidId(sectionId)
        && isValidHomepageSection(incoming())
        && incoming().id == sectionId
        && incoming().updatedAt == request.time;
      allow update: if hasPermission('banners_manage')
        && isValidId(sectionId)
        && isValidHomepageSection(incoming())
        && incoming().id == existing().id
        && incoming().updatedAt == request.time;
      allow delete: if isSuperAdmin() && isValidId(sectionId);
    }

    // Site Settings (Tiered: Super Admin / settings_view = all, banners_manage = heroSlides, showrooms_manage = About/Contact, chat_manage = supportOnline)
    match /site_settings/{settingId} {
      allow get: if isValidId(settingId);
      allow list: if true;
      allow create: if (
          isSuperAdmin()
          || hasPermission('settings_view')
          || (settingId == 'main' && (hasPermission('banners_manage') || hasPermission('showrooms_manage')))
        )
        && isValidId(settingId)
        && isValidSiteSettings(incoming())
        && incoming().updatedAt == request.time;
      allow update: if isValidId(settingId)
        && isValidSiteSettings(incoming())
        && incoming().updatedAt == request.time
        && (
          ((isSuperAdmin() || hasPermission('settings_view')) && incoming().diff(existing()).affectedKeys().hasOnly([
            'brandName', 'brandNameBn', 'brandNameEn', 'logoUrl', 'faviconUrl',
            'tagline', 'taglineBn', 'taglineEn',
            'shortDescriptionBn', 'shortDescriptionEn', 'longDescriptionBn', 'longDescriptionEn',
            'supportOnline', 'supportPhone', 'brandEmail', 'brandAddressBn', 'brandAddressEn',
            'messengerUrl', 'facebookUrl', 'instagramUrl', 'youtubeUrl', 'whatsappUrl',
            'footerTextBn', 'footerTextEn',
            'announcementEnabled', 'announcementBn', 'announcementEn', 'announcementLink',
            'primaryColor', 'accentColor', 'heroSlides', 'defaultLanguage',
            'aiSupportEnabled', 'aiAssistantName', 'aiFallbackMessage', 'aiCustomInstructions',
            'chatSupportHours', 'chatOfflineMessage', 'chatWelcomeMessage', 'chatCategories',
            'complaintCategories', 'complaintRefPrefix', 'complaintTemplates',
            'aboutHeadingEn', 'aboutHeadingBn', 'aboutSubtitleEn', 'aboutSubtitleBn',
            'aboutStoryEn', 'aboutStoryBn', 'aboutMissionEn', 'aboutMissionBn', 'aboutImageUrl',
            'contactHeadingEn', 'contactHeadingBn', 'contactSubtitleEn', 'contactSubtitleBn',
            'supportHoursEn', 'supportHoursBn', 'secondaryPhone', 'officeMapUrl',
            'updatedAt'
          ]))
          ||
          (hasPermission('showrooms_manage') && settingId == 'main' && incoming().diff(existing()).affectedKeys().hasOnly([
            'aboutHeadingEn', 'aboutHeadingBn', 'aboutSubtitleEn', 'aboutSubtitleBn',
            'aboutStoryEn', 'aboutStoryBn', 'aboutMissionEn', 'aboutMissionBn', 'aboutImageUrl',
            'contactHeadingEn', 'contactHeadingBn', 'contactSubtitleEn', 'contactSubtitleBn',
            'supportHoursEn', 'supportHoursBn', 'supportPhone', 'secondaryPhone', 'brandEmail',
            'brandAddressBn', 'brandAddressEn', 'officeMapUrl',
            'messengerUrl', 'facebookUrl', 'instagramUrl', 'youtubeUrl', 'whatsappUrl',
            'updatedAt'
          ]))
          ||
          (hasPermission('banners_manage') && settingId == 'main' && incoming().diff(existing()).affectedKeys().hasOnly([
            'heroSlides', 'updatedAt'
          ]))
          ||
          (hasPermission('chat_manage') && settingId == 'main' && incoming().diff(existing()).affectedKeys().hasOnly([
            'supportOnline', 'updatedAt'
          ]))
        );
      allow delete: if isSuperAdmin() && isValidId(settingId);
    }

    match /seo_settings/{settingId} {
      allow get: if isValidId(settingId);
      allow list: if true;
      allow create, update: if (isSuperAdmin() || hasPermission('seo_manage'))
        && isValidId(settingId)
        && isValidSeoSettings(incoming())
        && incoming().updatedAt == request.time;
      allow delete: if isSuperAdmin() && isValidId(settingId);
    }

    match /media/{mediaId} {
      allow get: if isValidId(mediaId);
      allow list: if true;
      allow create: if hasPermission('banners_manage')
        && isValidId(mediaId)
        && isValidMediaItem(incoming())
        && incoming().id == mediaId
        && incoming().createdAt == request.time;
      allow update: if hasPermission('banners_manage')
        && isValidId(mediaId)
        && isValidMediaItem(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'folder', 'deleted', 'updatedAt']);
      allow delete: if isSuperAdmin() && isValidId(mediaId);
    }

    match /ai_knowledge/{entryId} {
      allow get: if isValidId(entryId);
      allow list: if true;
      allow create: if (hasPermission('banners_manage') || hasPermission('chat_manage'))
        && isValidId(entryId)
        && isValidAiKnowledge(incoming())
        && incoming().id == entryId
        && incoming().updatedAt == request.time;
      allow update: if (hasPermission('banners_manage') || hasPermission('chat_manage'))
        && isValidId(entryId)
        && isValidAiKnowledge(incoming())
        && incoming().id == existing().id
        && incoming().updatedAt == request.time;
      allow delete: if (hasPermission('banners_manage') || hasPermission('chat_manage')) && isValidId(entryId);
    }

    // Strictly Private Complaints Box (Super Admin + Support Agent + submitter own UID only)
    match /complaints/{complaintId} {
      allow get: if isValidId(complaintId) && (
        isSupportStaff()
        || (hasVerifiedEmail() && 'submittedByUid' in existing() && existing().submittedByUid != '' && existing().submittedByUid == request.auth.uid)
      );
      allow list: if isSupportStaff()
        || (hasVerifiedEmail() && resource.data.submittedByUid == request.auth.uid);
      allow create: if isValidId(complaintId)
        && isValidComplaint(incoming())
        && incoming().id == complaintId
        && incoming().status == 'New'
        && incoming().adminNote == ''
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          (!isSignedIn() && (!('submittedByUid' in incoming()) || incoming().submittedByUid == ''))
          || (isSignedIn() && 'submittedByUid' in incoming() && incoming().submittedByUid == request.auth.uid)
        );
      allow update: if isSupportStaff()
        && isValidId(complaintId)
        && isValidComplaint(incoming())
        && (existing().status != 'Closed' || isSuperAdmin())
        && incoming().id == existing().id
        && incoming().referenceCode == existing().referenceCode
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'priority', 'adminNote', 'updatedAt']);
      allow delete: if isSuperAdmin() && isValidId(complaintId);
    }

    // Live Support Chat Sessions & Messages (Super Admin + Support Agent + owning customer only)
    match /chat_sessions/{sessionId} {
      allow get: if isSupportStaff()
        || (isValidChatSessionId(sessionId)
          && (!('customerUid' in existing()) || existing().customerUid == '' || (isSignedIn() && existing().customerUid == request.auth.uid)));
      allow list: if isSupportStaff();
      allow create: if isValidChatSessionId(sessionId)
        && isValidChatSession(incoming())
        && incoming().id == sessionId
        && incoming().status == 'waiting'
        && incoming().assignedAdminEmail == ''
        && incoming().assignedAdminName == ''
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          (!isSignedIn() && (!('customerUid' in incoming()) || incoming().customerUid == ''))
          || (isSignedIn() && 'customerUid' in incoming() && incoming().customerUid == request.auth.uid)
        );
      allow update: if isValidChatSessionId(sessionId)
        && isValidChatSession(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (isSupportStaff() && incoming().diff(existing()).affectedKeys().hasOnly([
            'status', 'assignedAdminEmail', 'assignedAdminName', 'lastMessage', 'updatedAt'
          ]))
          ||
          (existing().status != 'closed'
            && (!('customerUid' in existing()) || existing().customerUid == '' || (isSignedIn() && existing().customerUid == request.auth.uid))
            && (incoming().status == existing().status || incoming().status == 'closed')
            && incoming().diff(existing()).affectedKeys().hasOnly(['lastMessage', 'status', 'updatedAt']))
        );
      allow delete: if isSuperAdmin() && isValidChatSessionId(sessionId);

      match /messages/{messageId} {
        allow get: if isSupportStaff()
          || (isValidChatSessionId(sessionId)
            && isValidId(messageId)
            && (!('customerUid' in existing()) || existing().customerUid == '' || (isSignedIn() && existing().customerUid == request.auth.uid)));
        allow list: if isSupportStaff()
          || (isValidChatSessionId(sessionId)
            && resource.data.sessionId == sessionId
            && (!('customerUid' in resource.data) || resource.data.customerUid == '' || (isSignedIn() && resource.data.customerUid == request.auth.uid)));
        allow create: if isValidChatSessionId(sessionId)
          && isValidId(messageId)
          && isValidChatMessage(incoming())
          && incoming().id == messageId
          && incoming().sessionId == sessionId
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/chat_sessions/$(sessionId))
          && get(/databases/$(database)/documents/chat_sessions/$(sessionId)).data.status != 'closed'
          && (
            isSupportStaff()
            || (incoming().senderRole == 'customer'
              && (
                !('customerUid' in get(/databases/$(database)/documents/chat_sessions/$(sessionId)).data)
                || get(/databases/$(database)/documents/chat_sessions/$(sessionId)).data.customerUid == ''
                || (isSignedIn() && get(/databases/$(database)/documents/chat_sessions/$(sessionId)).data.customerUid == request.auth.uid)
              ))
          );
        allow update: if false;
        allow delete: if isSuperAdmin() && isValidChatSessionId(sessionId) && isValidId(messageId);
      }
    }

    // Immutable Admin Activity Audit Logs (Super Admin + dashboard/reports staff reads, active staff creates own log entry)
    match /activity_logs/{logId} {
      allow get: if isValidId(logId) && (isSuperAdmin() || hasPermission('reports_view') || hasPermission('dashboard_view'));
      allow list: if isSuperAdmin() || hasPermission('reports_view') || hasPermission('dashboard_view');
      allow create: if isValidId(logId)
        && hasAnyActiveStaffDoc()
        && isValidActivityLog(incoming())
        && incoming().id == logId
        && incoming().admin_uid == request.auth.uid
        && incoming().timestamp == request.time;
      allow update, delete: if false;
    }

    // Employee Recruitment Circulars (/jobPostings/{jobId})
    match /jobPostings/{jobId} {
      allow get: if isValidId(jobId) && (
        isRecruitmentStaff()
        || (existing().status == 'Published' && !('deleted' in existing() && existing().deleted == true))
      );
      allow list: if isRecruitmentStaff()
        || (resource.data.status == 'Published' && !('deleted' in resource.data && resource.data.deleted == true));
      allow create: if isRecruitmentStaff()
        && isValidId(jobId)
        && isValidJobPosting(incoming())
        && incoming().id == jobId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isRecruitmentStaff()
        && isValidId(jobId)
        && isValidJobPosting(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isSuperAdmin() && isValidId(jobId);
    }

    // Strictly Private Job Applications (/jobApplications/{applicationId})
    // Public can create only for an active Published job; public get/list is strictly denied (zero PII exposure)
    match /jobApplications/{applicationId} {
      allow get, list: if isRecruitmentStaff();
      allow create: if isValidId(applicationId)
        && isValidJobApplication(incoming())
        && incoming().id == applicationId
        && incoming().status == 'Submitted'
        && incoming().adminNotes == ''
        && (!('shortlisted' in incoming()) || incoming().shortlisted == false)
        && (!('archived' in incoming()) || incoming().archived == false)
        && (!('deleted' in incoming()) || incoming().deleted == false)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/jobPostings/$(incoming().jobId))
        && get(/databases/$(database)/documents/jobPostings/$(incoming().jobId)).data.status == 'Published'
        && !('deleted' in get(/databases/$(database)/documents/jobPostings/$(incoming().jobId)).data
          && get(/databases/$(database)/documents/jobPostings/$(incoming().jobId)).data.deleted == true);
      allow update: if isRecruitmentStaff()
        && isValidId(applicationId)
        && isValidJobApplication(incoming())
        && incoming().id == existing().id
        && incoming().applicationCode == existing().applicationCode
        && incoming().jobId == existing().jobId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'status', 'shortlisted', 'exam', 'interview', 'adminNotes', 'notes',
          'reviewedBy', 'reviewedAt', 'statusHistory', 'archived', 'deleted', 'updatedAt'
        ]);
      allow delete: if isSuperAdmin() && isValidId(applicationId);
    }

    // Zero-PII Atomic Deduplication Locks (/jobApplicationLocks/{lockId})
    match /jobApplicationLocks/{lockId} {
      allow get: if isValidId(lockId);
      allow list: if isSuperAdmin();
      allow create: if isValidId(lockId)
        && isValidJobApplicationLock(incoming())
        && incoming().id == lockId
        && incoming().createdAt == request.time
        && exists(/databases/$(database)/documents/jobPostings/$(incoming().jobId))
        && get(/databases/$(database)/documents/jobPostings/$(incoming().jobId)).data.status == 'Published';
      allow update: if false;
      allow delete: if isSuperAdmin() && isValidId(lockId);
    }

    // Zero-PII Annual Sequential ID Counter (/jobApplicationCounters/{yearId})
    match /jobApplicationCounters/{yearId} {
      allow get: if yearId.matches('^20[2-9][0-9]$');
      allow list: if isRecruitmentStaff();
      allow create: if yearId.matches('^20[2-9][0-9]$')
        && isValidJobApplicationCounter(incoming())
        && incoming().id == yearId
        && incoming().lastSeq == 1
        && incoming().updatedAt == request.time;
      allow update: if yearId.matches('^20[2-9][0-9]$')
        && isValidJobApplicationCounter(incoming())
        && incoming().id == existing().id
        && incoming().lastSeq == existing().lastSeq + 1
        && incoming().updatedAt == request.time;
      allow delete: if false;
    }

    // Recruitment Exam Definitions (/jobExams/{examId})
    match /jobExams/{examId} {
      allow get, list: if isRecruitmentStaff();
      allow create: if isRecruitmentStaff()
        && isValidId(examId)
        && isValidJobExam(incoming())
        && incoming().id == examId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isRecruitmentStaff()
        && isValidId(examId)
        && isValidJobExam(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isSuperAdmin() && isValidId(examId);
    }

    // Zero-PII Candidate Status Tracker (/jobApplicationStatuses/{statusId})
    match /jobApplicationStatuses/{statusId} {
      allow get: if isValidId(statusId);
      allow list: if isRecruitmentStaff();
      allow create: if isValidId(statusId)
        && isValidJobApplicationStatus(incoming())
        && incoming().id == statusId
        && incoming().status == 'Submitted'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/jobPostings/$(incoming().jobId))
        && get(/databases/$(database)/documents/jobPostings/$(incoming().jobId)).data.status == 'Published';
      allow update: if isRecruitmentStaff()
        && isValidId(statusId)
        && isValidJobApplicationStatus(incoming())
        && incoming().id == existing().id
        && incoming().jobId == existing().jobId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isSuperAdmin() && isValidId(statusId);
    }
  }
}
