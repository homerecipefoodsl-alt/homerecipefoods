        && data.status in ['waiting', 'active', 'closed']
        && data.assignedAdminEmail is string && data.assignedAdminEmail.size() <= 254
        && data.assignedAdminName is string && data.assignedAdminName.size() <= 120
        && data.lastMessage is string && data.lastMessage.size() <= 500
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidChatMessage(data) {
      return data.keys().hasAll(['id', 'sessionId', 'senderRole', 'senderName', 'text', 'createdAt'])
        && data.keys().hasOnly(['id', 'sessionId', 'customerUid', 'senderRole', 'senderName', 'text', 'createdAt'])
        && isValidId(data.id)
        && isValidChatSessionId(data.sessionId)
        && (!('customerUid' in data) || (data.customerUid is string && data.customerUid.size() <= 128))
        && data.senderRole in ['customer', 'admin', 'system']
        && data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 100
        && data.text is string && data.text.size() >= 1 && data.text.size() <= 2000
        && data.createdAt is timestamp;
    }

    function isValidJobPosting(data) {
      return data.keys().hasAll([
          'id', 'slug', 'title', 'category', 'vacancies', 'salary',
          'workplace', 'employmentType', 'description', 'responsibilities',
          'requirements', 'startDate', 'deadline', 'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'slug', 'title', 'titleEn', 'department', 'category', 'vacancies', 'salary', 'salaryType',
          'workplace', 'employmentType', 'workingHours', 'description', 'responsibilities',
          'requirements', 'educationRequirement', 'experienceRequirement', 'benefits',
          'startDate', 'deadline', 'status', 'contactInfo', 'instructions',
          'deleted', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && isValidSlug(data.slug)
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 160
        && (!('titleEn' in data) || (data.titleEn is string && data.titleEn.size() <= 160))
        && (!('department' in data) || (data.department is string && data.department.size() <= 100))
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 100
        && data.vacancies is int && data.vacancies >= 1 && data.vacancies <= 1000
        && data.salary is string && data.salary.size() >= 1 && data.salary.size() <= 120
        && (!('salaryType' in data) || (data.salaryType is string && data.salaryType.size() <= 60))
        && data.workplace is string && data.workplace.size() >= 1 && data.workplace.size() <= 160
        && data.employmentType is string && data.employmentType.size() >= 1 && data.employmentType.size() <= 80
        && (!('workingHours' in data) || (data.workingHours is string && data.workingHours.size() <= 120))
        && data.description is string && data.description.size() >= 5 && data.description.size() <= 4000
        && isBoundedStringList(data.responsibilities, 30, 300)
        && isBoundedStringList(data.requirements, 30, 300)
        && (!('educationRequirement' in data) || (data.educationRequirement is string && data.educationRequirement.size() <= 300))
        && (!('experienceRequirement' in data) || (data.experienceRequirement is string && data.experienceRequirement.size() <= 300))
        && (!('benefits' in data) || isBoundedStringList(data.benefits, 20, 200))
        && data.startDate is string && data.startDate.size() >= 8 && data.startDate.size() <= 32
        && data.deadline is string && data.deadline.size() >= 8 && data.deadline.size() <= 32
        && data.status in ['Draft', 'Published', 'Hidden', 'Closed']
        && (!('contactInfo' in data) || (data.contactInfo is string && data.contactInfo.size() <= 300))
        && (!('instructions' in data) || (data.instructions is string && data.instructions.size() <= 1000))
        && (!('deleted' in data) || data.deleted is bool)
        && (!('createdBy' in data) || (data.createdBy is string && data.createdBy.size() <= 254))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidJobApplication(data) {
      return data.keys().hasAll([
          'id', 'applicationCode', 'jobId', 'jobSlug', 'jobTitle', 'jobCategory',
          'fullName', 'dateOfBirth', 'gender', 'mobile', 'email', 'presentAddress',
          'educationLevel', 'hasPreviousExperience', 'appliedPosition', 'photoDataUrl',
          'cvUrlOrNote', 'status', 'adminNotes', 'submittedDateText', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'applicationCode', 'jobId', 'jobSlug', 'jobTitle', 'jobCategory',
          'fullName', 'fatherName', 'motherName', 'dateOfBirth', 'gender',
          'maritalStatus', 'nationality', 'nidNumber', 'passportNumber',
          'mobile', 'alternativeMobile', 'email', 'presentAddress', 'permanentAddress',
          'educationLevel', 'institution', 'subjectDepartment', 'passingYear', 'resultGpa',
          'hasPreviousExperience', 'experienceYears', 'previousOrganization',
          'currentOccupation', 'expectedSalary', 'appliedPosition',
          'computerSkills', 'languageSkills', 'aboutSelf', 'skills', 'referenceInfo',
          'photoUrl', 'photoStoragePath', 'photoDataUrl', 'documentUrls', 'cvUrlOrNote', 'declarationAccepted',
          'status', 'shortlisted', 'exam', 'interview', 'adminNotes', 'notes',
          'reviewedBy', 'reviewedAt', 'statusHistory', 'archived', 'deleted',
          'submittedDateText', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.applicationCode is string && data.applicationCode.size() >= 6 && data.applicationCode.size() <= 32 && data.applicationCode.matches('^[A-Z0-9\\-]+$')
        && isValidId(data.jobId)
        && isValidSlug(data.jobSlug)
        && data.jobTitle is string && data.jobTitle.size() >= 1 && data.jobTitle.size() <= 160
        && data.jobCategory is string && data.jobCategory.size() >= 1 && data.jobCategory.size() <= 100
        && data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 120
        && (!('fatherName' in data) || (data.fatherName is string && data.fatherName.size() <= 120))
        && (!('motherName' in data) || (data.motherName is string && data.motherName.size() <= 120))
        && data.dateOfBirth is string && data.dateOfBirth.size() >= 4 && data.dateOfBirth.size() <= 32
        && data.gender is string && data.gender.size() >= 1 && data.gender.size() <= 32
        && (!('maritalStatus' in data) || (data.maritalStatus is string && data.maritalStatus.size() <= 40))
        && (!('nationality' in data) || (data.nationality is string && data.nationality.size() <= 60))
        && (!('nidNumber' in data) || (data.nidNumber is string && data.nidNumber.size() <= 40))
        && (!('passportNumber' in data) || (data.passportNumber is string && data.passportNumber.size() <= 40))
        && data.mobile is string && data.mobile.size() >= 10 && data.mobile.size() <= 32
        && (!('alternativeMobile' in data) || (data.alternativeMobile is string && data.alternativeMobile.size() <= 32))
        && data.email is string && data.email.size() <= 254
        && data.presentAddress is string && data.presentAddress.size() >= 3 && data.presentAddress.size() <= 400
        && (!('permanentAddress' in data) || (data.permanentAddress is string && data.permanentAddress.size() <= 400))
        && data.educationLevel is string && data.educationLevel.size() >= 1 && data.educationLevel.size() <= 120
        && (!('institution' in data) || (data.institution is string && data.institution.size() <= 160))
        && (!('subjectDepartment' in data) || (data.subjectDepartment is string && data.subjectDepartment.size() <= 160))
        && (!('passingYear' in data) || (data.passingYear is string && data.passingYear.size() <= 20))
        && (!('resultGpa' in data) || (data.resultGpa is string && data.resultGpa.size() <= 40))
        && data.hasPreviousExperience is bool
        && (!('experienceYears' in data) || (data.experienceYears is string && data.experienceYears.size() <= 40))
        && (!('previousOrganization' in data) || (data.previousOrganization is string && data.previousOrganization.size() <= 160))
        && (!('currentOccupation' in data) || (data.currentOccupation is string && data.currentOccupation.size() <= 120))
        && (!('expectedSalary' in data) || (data.expectedSalary is string && data.expectedSalary.size() <= 60))
        && data.appliedPosition is string && data.appliedPosition.size() >= 1 && data.appliedPosition.size() <= 160
        && (!('computerSkills' in data) || (data.computerSkills is string && data.computerSkills.size() <= 400))
        && (!('languageSkills' in data) || (data.languageSkills is string && data.languageSkills.size() <= 400))
        && (!('aboutSelf' in data) || (data.aboutSelf is string && data.aboutSelf.size() <= 1500))
        && (!('skills' in data) || (data.skills is string && data.skills.size() <= 600))
        && (!('referenceInfo' in data) || (data.referenceInfo is string && data.referenceInfo.size() <= 400))
        && (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 2000))
        && (!('photoStoragePath' in data) || (data.photoStoragePath is string && data.photoStoragePath.size() <= 400))
        && data.photoDataUrl is string && data.photoDataUrl.size() <= 400000
        && (!('documentUrls' in data) || data.documentUrls is map)
        && data.cvUrlOrNote is string && data.cvUrlOrNote.size() <= 1000
        && (!('declarationAccepted' in data) || data.declarationAccepted is bool)
        && data.status in ['Submitted', 'Under Review', 'Shortlisted', 'Exam Scheduled', 'Exam Completed', 'Interview', 'Selected', 'Rejected', 'On Hold', 'Withdrawn']
        && (!('shortlisted' in data) || data.shortlisted is bool)
        && (!('exam' in data) || data.exam is map)
        && (!('interview' in data) || data.interview is map)
        && data.adminNotes is string && data.adminNotes.size() <= 2000
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 2000))
        && (!('reviewedBy' in data) || (data.reviewedBy is string && data.reviewedBy.size() <= 254))
        && (!('reviewedAt' in data) || (data.reviewedAt is string && data.reviewedAt.size() <= 64))
        && (!('statusHistory' in data) || (data.statusHistory is list && data.statusHistory.size() <= 30))
        && (!('archived' in data) || data.archived is bool)
        && (!('deleted' in data) || data.deleted is bool)
        && data.submittedDateText is string && data.submittedDateText.size() >= 4 && data.submittedDateText.size() <= 40
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidJobApplicationLock(data) {
      return data.keys().hasAll(['id', 'jobId', 'keyHash', 'createdAt'])
        && data.keys().hasOnly(['id', 'jobId', 'keyHash', 'createdAt'])
        && isValidId(data.id)
        && isValidId(data.jobId)
        && data.keyHash is string && data.keyHash.size() >= 16 && data.keyHash.size() <= 128
        && data.createdAt is timestamp;
    }

    function isValidJobApplicationStatus(data) {
      return data.keys().hasAll(['id', 'jobId', 'jobTitle', 'jobCategory', 'status', 'submittedDateText', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'id', 'jobId', 'jobTitle', 'jobCategory', 'mobileHash', 'status', 'submittedDateText',
          'examTitle', 'examDate', 'examStartTime', 'examEndTime', 'examDuration',
          'examTime', 'examLocation', 'examType', 'examInstructions',
          'examTotalMarks', 'examPassMarks',
          'interviewDate', 'interviewTime', 'interviewLocation', 'interviewType',
          'interviewStatus', 'interviewNotes',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && isValidId(data.jobId)
        && data.jobTitle is string && data.jobTitle.size() >= 1 && data.jobTitle.size() <= 160
        && data.jobCategory is string && data.jobCategory.size() >= 1 && data.jobCategory.size() <= 100
        && (!('mobileHash' in data) || (data.mobileHash is string && data.mobileHash.size() <= 128))
        && data.status in ['Submitted', 'Under Review', 'Shortlisted', 'Exam Scheduled', 'Exam Completed', 'Interview', 'Selected', 'Rejected', 'On Hold', 'Withdrawn']
        && data.submittedDateText is string && data.submittedDateText.size() >= 4 && data.submittedDateText.size() <= 40
        && (!('examTitle' in data) || (data.examTitle is string && data.examTitle.size() <= 160))
        && (!('examDate' in data) || (data.examDate is string && data.examDate.size() <= 40))
        && (!('examStartTime' in data) || (data.examStartTime is string && data.examStartTime.size() <= 40))
        && (!('examEndTime' in data) || (data.examEndTime is string && data.examEndTime.size() <= 40))
        && (!('examDuration' in data) || (data.examDuration is string && data.examDuration.size() <= 60))
        && (!('examTime' in data) || (data.examTime is string && data.examTime.size() <= 60))
        && (!('examLocation' in data) || (data.examLocation is string && data.examLocation.size() <= 200))
        && (!('examType' in data) || (data.examType is string && data.examType.size() <= 80))
        && (!('examInstructions' in data) || (data.examInstructions is string && data.examInstructions.size() <= 1000))
        && (!('examTotalMarks' in data) || (data.examTotalMarks is int && data.examTotalMarks >= 0 && data.examTotalMarks <= 10000))
        && (!('examPassMarks' in data) || (data.examPassMarks is int && data.examPassMarks >= 0 && data.examPassMarks <= 10000))
        && (!('interviewDate' in data) || (data.interviewDate is string && data.interviewDate.size() <= 40))
        && (!('interviewTime' in data) || (data.interviewTime is string && data.interviewTime.size() <= 40))
        && (!('interviewLocation' in data) || (data.interviewLocation is string && data.interviewLocation.size() <= 200))
        && (!('interviewType' in data) || (data.interviewType is string && data.interviewType.size() <= 80))
        && (!('interviewStatus' in data) || (data.interviewStatus in ['scheduled', 'completed', 'cancelled']))
        && (!('interviewNotes' in data) || (data.interviewNotes is string && data.interviewNotes.size() <= 600))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidJobApplicationCounter(data) {
      return data.keys().hasAll(['id', 'lastSeq', 'updatedAt'])
        && data.keys().hasOnly(['id', 'lastSeq', 'updatedAt'])
        && data.id is string && data.id.matches('^20[2-9][0-9]$')
        && data.lastSeq is int && data.lastSeq >= 1 && data.lastSeq <= 9999999
        && data.updatedAt is timestamp;
    }

    function isValidJobExam(data) {
      return data.keys().hasAll([
          'id', 'title', 'jobId', 'jobTitle', 'examDate', 'startTime', 'endTime',
          'duration', 'location', 'examType', 'instructions', 'totalMarks', 'passMarks',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'title', 'jobId', 'jobTitle', 'examDate', 'startTime', 'endTime',
          'duration', 'location', 'examType', 'instructions', 'totalMarks', 'passMarks',
          'createdBy', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 160
        && isValidId(data.jobId)
        && data.jobTitle is string && data.jobTitle.size() >= 1 && data.jobTitle.size() <= 160
        && data.examDate is string && data.examDate.size() >= 4 && data.examDate.size() <= 40
        && data.startTime is string && data.startTime.size() >= 1 && data.startTime.size() <= 40
        && data.endTime is string && data.endTime.size() >= 1 && data.endTime.size() <= 40
        && data.duration is string && data.duration.size() >= 1 && data.duration.size() <= 60
        && data.location is string && data.location.size() >= 1 && data.location.size() <= 200
        && data.examType is string && data.examType.size() >= 1 && data.examType.size() <= 80
        && data.instructions is string && data.instructions.size() <= 1000
        && data.totalMarks is int && data.totalMarks >= 1 && data.totalMarks <= 10000
        && data.passMarks is int && data.passMarks >= 0 && data.passMarks <= data.totalMarks
        && (!('createdBy' in data) || (data.createdBy is string && data.createdBy.size() <= 254))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // ==============================================
    // Collection Rules
    // ==============================================

    // Authoritative RBAC Roles Registry (/rbac_roles/{emailKey})
    match /rbac_roles/{emailKey} {
      allow get: if isValidEmailId(emailKey)
        && (isSuperAdmin() || hasPermission('manager_manage') || (hasVerifiedEmail() && authEmail() == emailKey));
      allow list: if isSuperAdmin() || hasPermission('manager_manage');
      allow create: if isValidEmailId(emailKey)
        && isValidRbacRole(incoming())
        && incoming().email == emailKey
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          (hasVerifiedEmail()
            && authEmail() == 'mdmahmudulhashan0@gmail.com'
            && emailKey == 'mdmahmudulhashan0@gmail.com'
            && incoming().uid == request.auth.uid
            && incoming().role in ['primary_super_admin', 'super_admin']
            && incoming().status == 'active')
          ||
          (isPrimarySuperAdmin()
            && emailKey != 'mdmahmudulhashan0@gmail.com'
            && incoming().role in ['primary_super_admin', 'super_admin', 'admin', 'manager', 'editor', 'moderator', 'support_agent'])
          ||
          (isSuperAdmin()
            && emailKey != 'mdmahmudulhashan0@gmail.com'
            && incoming().role in ['admin', 'manager', 'editor', 'moderator', 'support_agent'])
          ||
          (hasPermission('manager_manage')
            && emailKey != 'mdmahmudulhashan0@gmail.com'
            && incoming().role == 'manager')
        );
      allow update: if isValidEmailId(emailKey)
        && isValidRbacRole(incoming())
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (isSuperAdmin()
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'uid', 'username', 'name', 'displayName', 'phone', 'managerId', 'managerTitle',
              'permissions', 'role', 'status', 'addedByEmail', 'createdBy', 'updatedAt', 'lastLoginAt'
            ])
            && (
              (emailKey == 'mdmahmudulhashan0@gmail.com'
                && incoming().role in ['primary_super_admin', 'super_admin']
                && incoming().status == 'active')
              ||
              (isPrimarySuperAdmin()
                && emailKey != 'mdmahmudulhashan0@gmail.com'
                && incoming().role in ['primary_super_admin', 'super_admin', 'admin', 'manager', 'editor', 'moderator', 'support_agent'])
              ||
              (emailKey != 'mdmahmudulhashan0@gmail.com'
                && incoming().role in ['admin', 'manager', 'editor', 'moderator', 'support_agent'])
            ))
          ||
          (hasPermission('manager_manage')
            && emailKey != 'mdmahmudulhashan0@gmail.com'
            && existing().role == 'manager'
            && incoming().role == 'manager'
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'uid', 'username', 'displayName', 'phone', 'managerId', 'managerTitle',
              'permissions', 'status', 'updatedAt'
            ]))
          ||
          (hasVerifiedEmail()
            && authEmail() == emailKey
            && existing().status == 'active'
            && existing().uid == ''
            && incoming().uid == request.auth.uid
            && incoming().role == existing().role
            && incoming().status == existing().status
            && (!('permissions' in existing()) || incoming().permissions == existing().permissions)
            && incoming().diff(existing()).affectedKeys().hasOnly(['uid', 'displayName', 'updatedAt']))
        );
      allow delete: if isSuperAdmin()
        && isValidEmailId(emailKey)
        && emailKey != 'mdmahmudulhashan0@gmail.com';
    }

    // Admin Username-to-Email Lookup (/admin_usernames/{usernameId})
    // Single-document get only (no list enumeration) so /mahmud supports username sign-in securely
    match /admin_usernames/{usernameId} {
      allow get: if isValidId(usernameId);
      allow list: if false;
      allow create, update: if isValidId(usernameId)
        && isValidAdminUsername(incoming())
        && incoming().username == usernameId
        && incoming().updatedAt == request.time
        && (
          isSuperAdmin()
          || (hasPermission('manager_manage') && usernameId != 'mahmud' && incoming().email != 'mdmahmudulhashan0@gmail.com')
          || (isPrimarySuperAdmin() && usernameId == 'mahmud' && incoming().email == 'mdmahmudulhashan0@gmail.com')
        );
      allow delete: if isSuperAdmin()
        && isValidId(usernameId)
        && usernameId != 'mahmud';
    }

    // Registered User Accounts (/users/{userId})
    match /users/{userId} {
      allow get: if isValidId(userId)
        && (isSuperAdmin() || (hasVerifiedEmail() && request.auth.uid == userId));
      allow list: if isSuperAdmin();
      allow create: if hasVerifiedEmail()
        && isValidId(userId)
        && isValidUserAccount(incoming())
        && incoming().uid == userId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && incoming().lastLoginAt == request.time
        && (
          (isPrimarySuperAdmin() && incoming().role in ['primary_super_admin', 'super_admin', 'admin', 'manager', 'editor', 'moderator', 'support_agent', 'customer'])
          ||
          (isSuperAdmin() && incoming().role in ['admin', 'manager', 'editor', 'moderator', 'support_agent', 'customer'])
          ||
          (request.auth.uid == userId
            && incoming().email == authEmail()
            && (
              (isPrimarySuperAdmin() && incoming().role in ['primary_super_admin', 'super_admin'] && incoming().status == 'active')
              || (!isPrimarySuperAdmin() && hasAnyActiveStaffDoc() && incoming().role == currentStaffRole() && incoming().status == 'active')
              || (!isPrimarySuperAdmin() && !hasAnyActiveStaffDoc() && incoming().role == 'customer' && incoming().status == 'active')
            ))
        );
      allow update: if isValidId(userId)
        && isValidUserAccount(incoming())
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (isSuperAdmin()
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'name', 'displayName', 'photoUrl', 'phone', 'managerId', 'permissions',
              'role', 'status', 'createdBy', 'updatedAt', 'lastLoginAt'
            ])
            && (
              (existing().email == 'mdmahmudulhashan0@gmail.com'
                && incoming().role in ['primary_super_admin', 'super_admin']
                && incoming().status == 'active')
              ||
              (isPrimarySuperAdmin()
                && existing().email != 'mdmahmudulhashan0@gmail.com'
                && incoming().role in ['customer', 'primary_super_admin', 'super_admin', 'admin', 'manager', 'editor', 'moderator', 'support_agent'])
              ||
              (existing().email != 'mdmahmudulhashan0@gmail.com'
                && incoming().role in ['customer', 'admin', 'manager', 'editor', 'moderator', 'support_agent'])
            ))
          ||
          (hasVerifiedEmail()
            && request.auth.uid == userId
            && incoming().status == existing().status
            && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoUrl', 'role', 'updatedAt', 'lastLoginAt'])
            && (
              (isPrimarySuperAdmin() && incoming().role in ['primary_super_admin', 'super_admin'])
              || (!isPrimarySuperAdmin() && hasAnyActiveStaffDoc() && incoming().role == currentStaffRole())
              || (!isPrimarySuperAdmin() && !hasAnyActiveStaffDoc() && incoming().role == 'customer')
            ))
        );
      allow delete: if isSuperAdmin()
        && isValidId(userId)
        && userId != request.auth.uid
        && existing().email != 'mdmahmudulhashan0@gmail.com';
    }

    // Admin Records (/admins/{adminUid}) - Client self-creation/self-elevation strictly prohibited
    match /admins/{adminUid} {
      allow get: if isValidId(adminUid)
        && (isSuperAdmin() || hasPermission('manager_manage') || (hasVerifiedEmail() && request.auth.uid == adminUid));
      allow list: if isSuperAdmin() || hasPermission('manager_manage');
      allow create: if isValidId(adminUid)
        && isValidAdminRecord(incoming())
        && incoming().uid == adminUid
        && (
          (adminUid == request.auth.uid
            && hasVerifiedEmail()
            && authEmail() == 'mdmahmudulhashan0@gmail.com'
            && incoming().email == 'mdmahmudulhashan0@gmail.com'
            && incoming().role == 'primary_super_admin'
            && incoming().active == true
            && incoming().isActive == true
            && incoming().status == 'active'
            && incoming().created_at == request.time
            && incoming().updated_at == request.time)
          ||
          (adminUid != request.auth.uid
            && (
              (isPrimarySuperAdmin() && incoming().role in ['primary_super_admin', 'super_admin', 'admin', 'manager', 'editor', 'moderator', 'support_agent'])
              || (isSuperAdmin() && incoming().role in ['admin', 'manager', 'editor', 'moderator', 'support_agent'] && incoming().email != 'mdmahmudulhashan0@gmail.com')
              || (hasPermission('manager_manage') && incoming().role == 'manager' && incoming().email != 'mdmahmudulhashan0@gmail.com')
            ))
        );
      allow update: if isValidId(adminUid)
        && isValidAdminRecord(incoming())
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && adminUid != request.auth.uid
        && (
          (isPrimarySuperAdmin() && incoming().role in ['primary_super_admin', 'super_admin', 'admin', 'manager', 'editor', 'moderator', 'support_agent'])
          || (isSuperAdmin()
            && existing().email != 'mdmahmudulhashan0@gmail.com'
            && existing().role != 'primary_super_admin'
            && incoming().role in ['admin', 'manager', 'editor', 'moderator', 'support_agent'])
          || (hasPermission('manager_manage')
            && existing().role == 'manager'
            && incoming().role == 'manager'
            && existing().email != 'mdmahmudulhashan0@gmail.com')
        );
      allow delete: if isSuperAdmin()
        && isValidId(adminUid)
        && adminUid != request.auth.uid
        && existing().email != 'mdmahmudulhashan0@gmail.com'
        && existing().role != 'primary_super_admin';
    }

    // Public Catalog Showcase (Granular permission enforcement)
    match /categories/{categoryId} {
      allow get: if isValidId(categoryId);
      allow list: if true;
      allow create: if hasCatalogWritePerm('categories_manage')
        && isValidId(categoryId)
        && isValidCategory(incoming())
        && incoming().id == categoryId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if hasCatalogWritePerm('categories_manage')
        && isValidId(categoryId)
        && isValidCategory(incoming())
        && (
          ('id' in existing() && isValidId(existing().id) && incoming().id == existing().id)
          || ((!('id' in existing()) || !isValidId(existing().id)) && incoming().id == categoryId)
        )
        && incoming().updatedAt == request.time
        && (
          ('createdAt' in existing()
            && existing().createdAt is timestamp
            && incoming().createdAt == existing().createdAt
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'id', 'name', 'nameEn', 'name_bn', 'name_en', 'slug', 'icon',
              'description', 'descriptionEn', 'description_bn', 'description_en',
              'image', 'order', 'visible', 'active', 'deleted', 'archivedAt', 'seoTitle', 'seoDescription',
              'updatedAt'
            ]))
          ||
          ((!('createdAt' in existing()) || !(existing().createdAt is timestamp))
            && incoming().createdAt == request.time
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'id', 'name', 'nameEn', 'name_bn', 'name_en', 'slug', 'icon',
              'description', 'descriptionEn', 'description_bn', 'description_en',
              'image', 'order', 'visible', 'active', 'deleted', 'archivedAt', 'seoTitle', 'seoDescription',
              'createdAt', 'updatedAt'
            ]))
        );
      allow delete: if hasCatalogWritePerm('categories_manage') && isValidId(categoryId);
    }

    match /occasions/{occasionId} {
      allow get: if isValidId(occasionId);
