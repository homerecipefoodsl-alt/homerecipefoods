rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Core Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidEmailId(emailId) {
      return emailId is string
        && emailId.size() >= 3
        && emailId.size() <= 254
        && emailId.matches('^[a-z0-9._%+\\-]+@[a-z0-9.\\-]+\\.[a-z]{2,}$');
    }

    function isValidChatSessionId(id) {
      return id is string && id.size() >= 24 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidSlug(slug) {
      return slug is string && slug.size() >= 1 && slug.size() <= 160 && slug.matches('^[a-z0-9\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function hasVerifiedEmail() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && ('email' in request.auth.token)
        && request.auth.token.email is string;
    }

    function authEmail() {
      return request.auth.token.email.lower();
    }

    // Primary Super Admin identity gate (verified Firebase Auth token only)
    function isPrimarySuperAdmin() {
      return hasVerifiedEmail() && authEmail() == 'mdmahmudulhashan0@gmail.com';
    }

    // Authoritative RBAC role lookup in Firestore (/rbac_roles/{email})
    function hasActiveRbacDoc() {
      return hasVerifiedEmail()
        && exists(/databases/$(database)/documents/rbac_roles/$(authEmail()))
        && get(/databases/$(database)/documents/rbac_roles/$(authEmail())).data.status == 'active';
    }

    function rbacDoc() {
      return get(/databases/$(database)/documents/rbac_roles/$(authEmail())).data;
    }

    function rbacRole() {
      return rbacDoc().role;
    }

    function isSuperAdmin() {
      return isPrimarySuperAdmin()
        || (hasActiveRbacDoc() && rbacRole() == 'super_admin');
    }

    function hasPermission(perm) {
      return isSuperAdmin()
        || (hasActiveRbacDoc() && (
          ('permissions' in rbacDoc() && rbacDoc().permissions is list && perm in rbacDoc().permissions)
          || (!('permissions' in rbacDoc()) && rbacDoc().role == 'admin' && perm in [
            'dashboard_view', 'products_view', 'products_add', 'products_edit', 'products_delete',
            'categories_manage', 'showrooms_manage', 'banners_manage', 'reports_view'
          ])
          || (!('permissions' in rbacDoc()) && rbacDoc().role == 'manager' && perm in [
            'dashboard_view', 'products_view', 'products_add', 'products_edit',
            'categories_manage', 'showrooms_manage', 'complaints_manage', 'reports_view'
          ])
          || (!('permissions' in rbacDoc()) && rbacDoc().role == 'support_agent' && perm in [
            'dashboard_view', 'complaints_manage', 'chat_manage'
          ])
        ));
    }

    function isCatalogAdmin() {
      return isSuperAdmin()
        || (hasActiveRbacDoc() && rbacRole() in ['admin', 'manager']);
    }

    function isSupportAgent() {
      return hasActiveRbacDoc() && rbacRole() == 'support_agent';
    }

    function isSupportStaff() {
      return isSuperAdmin() || hasPermission('complaints_manage') || hasPermission('chat_manage');
    }

    function isBoundedStringList(arr, maxLen, maxItemLen) {
      return arr is list
        && arr.size() <= maxLen
        && (arr.size() == 0 || (arr[0] is string && arr[0].size() <= maxItemLen));
    }

    // Entity Validators
    function isValidRbacRole(data) {
      return data.keys().hasAll(['email', 'uid', 'displayName', 'role', 'status', 'addedByEmail', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'email', 'uid', 'username', 'displayName', 'phone', 'managerId', 'managerTitle',
          'permissions', 'role', 'status', 'addedByEmail', 'createdBy', 'createdAt', 'updatedAt', 'lastLoginAt'
        ])
        && isValidEmailId(data.email)
        && data.uid is string && data.uid.size() <= 128
        && (!('username' in data) || (data.username is string && data.username.size() <= 64))
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 40))
        && (!('managerId' in data) || (data.managerId is string && data.managerId.size() <= 64))
        && (!('managerTitle' in data) || (data.managerTitle is string && data.managerTitle.size() <= 100))
        && (!('permissions' in data) || isBoundedStringList(data.permissions, 25, 64))
        && data.role in ['super_admin', 'admin', 'manager', 'support_agent']
        && data.status in ['active', 'disabled', 'suspended']
        && data.addedByEmail is string && data.addedByEmail.size() <= 254
        && (!('createdBy' in data) || (data.createdBy is string && data.createdBy.size() <= 254))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && (!('lastLoginAt' in data) || data.lastLoginAt is timestamp);
    }

    function isValidAdminUsername(data) {
      return data.keys().hasAll(['username', 'email', 'active', 'updatedAt'])
        && data.keys().hasOnly(['username', 'email', 'active', 'updatedAt'])
        && isValidId(data.username)
        && isValidEmailId(data.email)
        && data.active is bool
        && data.updatedAt is timestamp;
    }

    function isValidUserAccount(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'photoUrl', 'role', 'status', 'createdAt', 'updatedAt', 'lastLoginAt'])
        && data.keys().hasOnly([
          'uid', 'email', 'displayName', 'photoUrl', 'phone', 'managerId',
          'permissions', 'role', 'status', 'createdBy', 'createdAt', 'updatedAt', 'lastLoginAt'
        ])
        && isValidId(data.uid)
        && isValidEmailId(data.email)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && data.photoUrl is string && data.photoUrl.size() <= 500
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 40))
        && (!('managerId' in data) || (data.managerId is string && data.managerId.size() <= 64))
        && (!('permissions' in data) || isBoundedStringList(data.permissions, 25, 64))
        && data.role in ['super_admin', 'admin', 'manager', 'support_agent', 'customer']
        && data.status in ['active', 'disabled', 'suspended']
        && (!('createdBy' in data) || (data.createdBy is string && data.createdBy.size() <= 254))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.lastLoginAt is timestamp;
    }

    function isValidAdminRecord(data) {
      return (
        data.keys().hasAll(['uid', 'email', 'username', 'display_name', 'role', 'active', 'created_at', 'updated_at'])
        && data.keys().hasOnly([
          'uid', 'email', 'username', 'display_name', 'phone', 'manager_id', 'manager_title',
          'permissions', 'role', 'active', 'status', 'created_by', 'created_at', 'updated_at', 'last_login_at'
        ])
        && isValidId(data.uid)
        && isValidEmailId(data.email)
        && data.username is string && data.username.size() <= 64
        && data.display_name is string && data.display_name.size() >= 1 && data.display_name.size() <= 120
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 40))
        && (!('manager_id' in data) || (data.manager_id is string && data.manager_id.size() <= 64))
        && (!('manager_title' in data) || (data.manager_title is string && data.manager_title.size() <= 100))
        && (!('permissions' in data) || isBoundedStringList(data.permissions, 25, 64))
        && data.role in ['super_admin', 'admin', 'manager', 'support_agent']
        && data.active is bool
        && (!('status' in data) || data.status in ['active', 'disabled', 'suspended'])
        && (!('created_by' in data) || (data.created_by is string && data.created_by.size() <= 254))
        && data.created_at is timestamp
        && data.updated_at is timestamp
        && (!('last_login_at' in data) || data.last_login_at is timestamp)
      ) || (
        data.keys().hasAll(['uid', 'email', 'displayName', 'role', 'isOnline', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'isOnline', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && data.role in ['super_admin', 'admin', 'manager', 'support_agent']
        && data.isOnline is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
      );
    }

    function isValidCategory(data) {
      return data.keys().hasAll(['id', 'name', 'nameEn', 'slug', 'description', 'image', 'order', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'id', 'name', 'nameEn', 'name_bn', 'name_en', 'slug', 'icon',
          'description', 'descriptionEn', 'description_bn', 'description_en',
          'image', 'order', 'visible', 'deleted', 'archivedAt', 'seoTitle', 'seoDescription',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.nameEn is string && data.nameEn.size() >= 1 && data.nameEn.size() <= 120
        && (!('name_bn' in data) || (data.name_bn is string && data.name_bn.size() <= 120))
        && (!('name_en' in data) || (data.name_en is string && data.name_en.size() <= 120))
        && isValidSlug(data.slug)
        && (!('icon' in data) || (data.icon is string && data.icon.size() <= 40))
        && data.description is string && data.description.size() >= 1 && data.description.size() <= 600
        && (!('descriptionEn' in data) || (data.descriptionEn is string && data.descriptionEn.size() <= 600))
        && (!('description_bn' in data) || (data.description_bn is string && data.description_bn.size() <= 600))
        && (!('description_en' in data) || (data.description_en is string && data.description_en.size() <= 600))
        && data.image is string && data.image.size() >= 1 && data.image.size() <= 500000
        && data.order is int && data.order >= 0 && data.order <= 1000
        && (!('visible' in data) || data.visible is bool)
        && (!('deleted' in data) || data.deleted is bool)
        && (!('seoTitle' in data) || (data.seoTitle is string && data.seoTitle.size() <= 200))
        && (!('seoDescription' in data) || (data.seoDescription is string && data.seoDescription.size() <= 400))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidOccasion(data) {
      return data.keys().hasAll(['id', 'name', 'nameEn', 'slug', 'icon', 'description', 'order', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'id', 'name', 'nameEn', 'name_bn', 'name_en', 'slug', 'icon',
          'description', 'descriptionEn', 'description_bn', 'description_en',
          'order', 'visible', 'deleted', 'archivedAt', 'seoTitle', 'seoDescription',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.nameEn is string && data.nameEn.size() >= 1 && data.nameEn.size() <= 120
        && (!('name_bn' in data) || (data.name_bn is string && data.name_bn.size() <= 120))
        && (!('name_en' in data) || (data.name_en is string && data.name_en.size() <= 120))
        && isValidSlug(data.slug)
        && data.icon is string && data.icon.size() >= 1 && data.icon.size() <= 32
        && data.description is string && data.description.size() >= 1 && data.description.size() <= 600
        && (!('descriptionEn' in data) || (data.descriptionEn is string && data.descriptionEn.size() <= 600))
        && (!('description_bn' in data) || (data.description_bn is string && data.description_bn.size() <= 600))
        && (!('description_en' in data) || (data.description_en is string && data.description_en.size() <= 600))
        && data.order is int && data.order >= 0 && data.order <= 1000
        && (!('visible' in data) || data.visible is bool)
        && (!('deleted' in data) || data.deleted is bool)
        && (!('seoTitle' in data) || (data.seoTitle is string && data.seoTitle.size() <= 200))
        && (!('seoDescription' in data) || (data.seoDescription is string && data.seoDescription.size() <= 400))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidProduct(data) {
      return data.keys().hasAll([
          'id', 'name', 'nameEn', 'slug', 'category', 'categoryName', 'productType',
          'price', 'priceUnit', 'shortDescription', 'description', 'images', 'ingredients',
          'sizes', 'weight', 'occasions', 'showrooms', 'availability', 'importantNotes',
          'featured', 'popular', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'name', 'nameEn', 'name_bn', 'name_en', 'slug',
          'category', 'categoryName', 'categoryNameEn', 'productType',
          'price', 'old_price', 'discount', 'price_label', 'priceUnit',
          'shortDescription', 'shortDescriptionEn', 'short_description_bn', 'short_description_en',
          'description', 'descriptionEn', 'description_bn', 'description_en',
          'images', 'ingredients', 'ingredients_bn', 'ingredients_en', 'sizes', 'weight', 'occasions', 'showrooms',
          'availability', 'importantNotes', 'featured', 'popular',
          'visible', 'deleted', 'status', 'display_order', 'archivedAt', 'seoTitle', 'seoDescription', 'seoImage',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 160
        && data.nameEn is string && data.nameEn.size() >= 1 && data.nameEn.size() <= 160
        && (!('name_bn' in data) || (data.name_bn is string && data.name_bn.size() <= 160))
        && (!('name_en' in data) || (data.name_en is string && data.name_en.size() <= 160))
        && isValidSlug(data.slug)
        && isValidSlug(data.category)
        && data.categoryName is string && data.categoryName.size() >= 1 && data.categoryName.size() <= 120
        && (!('categoryNameEn' in data) || (data.categoryNameEn is string && data.categoryNameEn.size() <= 120))
        && data.productType is string && data.productType.size() >= 1 && data.productType.size() <= 120
        && data.price is number && data.price >= 0 && data.price <= 1000000
        && (!('old_price' in data) || (data.old_price is number && data.old_price >= 0 && data.old_price <= 1000000))
        && (!('discount' in data) || (data.discount is string && data.discount.size() <= 60))
        && (!('price_label' in data) || (data.price_label is string && data.price_label.size() <= 80))
        && data.priceUnit is string && data.priceUnit.size() >= 1 && data.priceUnit.size() <= 60
        && data.shortDescription is string && data.shortDescription.size() >= 1 && data.shortDescription.size() <= 300
        && (!('shortDescriptionEn' in data) || (data.shortDescriptionEn is string && data.shortDescriptionEn.size() <= 300))
        && (!('short_description_bn' in data) || (data.short_description_bn is string && data.short_description_bn.size() <= 300))
        && (!('short_description_en' in data) || (data.short_description_en is string && data.short_description_en.size() <= 300))
        && data.description is string && data.description.size() >= 1 && data.description.size() <= 4000
        && (!('descriptionEn' in data) || (data.descriptionEn is string && data.descriptionEn.size() <= 4000))
        && (!('description_bn' in data) || (data.description_bn is string && data.description_bn.size() <= 4000))
        && (!('description_en' in data) || (data.description_en is string && data.description_en.size() <= 4000))
        && isBoundedStringList(data.images, 6, 400000)
        && isBoundedStringList(data.ingredients, 25, 120)
        && (!('ingredients_bn' in data) || (data.ingredients_bn is string && data.ingredients_bn.size() <= 600))
        && (!('ingredients_en' in data) || (data.ingredients_en is string && data.ingredients_en.size() <= 600))
        && isBoundedStringList(data.sizes, 10, 80)
        && data.weight is string && data.weight.size() <= 80
        && isBoundedStringList(data.occasions, 15, 80)
        && isBoundedStringList(data.showrooms, 20, 128)
        && data.availability in ['In Showroom', 'Pre-Order at Showroom', 'Seasonal', 'Out of Stock']
        && data.importantNotes is string && data.importantNotes.size() <= 800
        && data.featured is bool
        && data.popular is bool
        && (!('visible' in data) || data.visible is bool)
        && (!('deleted' in data) || data.deleted is bool)
        && (!('status' in data) || data.status in ['draft', 'published', 'archived'])
        && (!('display_order' in data) || (data.display_order is int && data.display_order >= 0 && data.display_order <= 10000))
        && (!('seoTitle' in data) || (data.seoTitle is string && data.seoTitle.size() <= 200))
        && (!('seoDescription' in data) || (data.seoDescription is string && data.seoDescription.size() <= 400))
        && (!('seoImage' in data) || (data.seoImage is string && data.seoImage.size() <= 400000))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidShowroom(data) {
      return data.keys().hasAll(['id', 'name', 'area', 'address', 'phone', 'openingHours', 'mapUrl', 'lat', 'lng', 'isMain', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'id', 'name', 'nameEn', 'name_bn', 'name_en',
          'area', 'areaEn', 'address', 'addressEn', 'address_bn', 'address_en',
          'description', 'descriptionEn', 'description_bn', 'description_en',
          'phone', 'alternate_phone', 'email',
          'openingHours', 'openingHoursEn', 'opening_time', 'closing_time', 'weekly_holiday',
          'mapUrl', 'lat', 'lng', 'images', 'available_categories', 'available_products',
          'isMain', 'visible', 'deleted', 'display_order', 'archivedAt', 'seoTitle', 'seoDescription',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 140
        && (!('nameEn' in data) || (data.nameEn is string && data.nameEn.size() <= 140))
        && (!('name_bn' in data) || (data.name_bn is string && data.name_bn.size() <= 140))
        && (!('name_en' in data) || (data.name_en is string && data.name_en.size() <= 140))
        && data.area is string && data.area.size() >= 1 && data.area.size() <= 100
        && (!('areaEn' in data) || (data.areaEn is string && data.areaEn.size() <= 100))
        && data.address is string && data.address.size() >= 1 && data.address.size() <= 400
        && (!('addressEn' in data) || (data.addressEn is string && data.addressEn.size() <= 400))
        && (!('address_bn' in data) || (data.address_bn is string && data.address_bn.size() <= 400))
        && (!('address_en' in data) || (data.address_en is string && data.address_en.size() <= 400))
        && (!('description' in data) || (data.description is string && data.description.size() <= 600))
        && (!('descriptionEn' in data) || (data.descriptionEn is string && data.descriptionEn.size() <= 600))
        && (!('description_bn' in data) || (data.description_bn is string && data.description_bn.size() <= 600))
        && (!('description_en' in data) || (data.description_en is string && data.description_en.size() <= 600))
        && data.phone is string && data.phone.size() >= 5 && data.phone.size() <= 40
        && (!('alternate_phone' in data) || (data.alternate_phone is string && data.alternate_phone.size() <= 40))
        && (!('email' in data) || (data.email is string && data.email.size() <= 254))
        && data.openingHours is string && data.openingHours.size() >= 1 && data.openingHours.size() <= 160
        && (!('openingHoursEn' in data) || (data.openingHoursEn is string && data.openingHoursEn.size() <= 160))
        && (!('opening_time' in data) || (data.opening_time is string && data.opening_time.size() <= 40))
        && (!('closing_time' in data) || (data.closing_time is string && data.closing_time.size() <= 40))
        && (!('weekly_holiday' in data) || (data.weekly_holiday is string && data.weekly_holiday.size() <= 80))
        && data.mapUrl is string && data.mapUrl.size() >= 1 && data.mapUrl.size() <= 600
        && data.lat is number && data.lat >= -90 && data.lat <= 90
        && data.lng is number && data.lng >= -180 && data.lng <= 180
        && (!('images' in data) || isBoundedStringList(data.images, 6, 400000))
        && (!('available_categories' in data) || isBoundedStringList(data.available_categories, 30, 80))
        && (!('available_products' in data) || isBoundedStringList(data.available_products, 200, 128))
        && data.isMain is bool
        && (!('visible' in data) || data.visible is bool)
        && (!('deleted' in data) || data.deleted is bool)
        && (!('display_order' in data) || (data.display_order is int && data.display_order >= 0 && data.display_order <= 1000))
        && (!('seoTitle' in data) || (data.seoTitle is string && data.seoTitle.size() <= 200))
        && (!('seoDescription' in data) || (data.seoDescription is string && data.seoDescription.size() <= 400))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidComplaint(data) {
      return data.keys().hasAll([
          'id', 'referenceCode', 'customerName', 'phone', 'email', 'category',
          'showroomId', 'showroomName', 'message', 'attachmentImage', 'status',
          'adminNote', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'referenceCode', 'submittedByUid', 'customerName', 'phone', 'email', 'category',
          'showroomId', 'showroomName', 'message', 'attachmentImage', 'status', 'priority',
          'adminNote', 'deleted', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && (!('submittedByUid' in data) || (data.submittedByUid is string && data.submittedByUid.size() <= 128))
        && data.referenceCode is string && data.referenceCode.size() >= 4 && data.referenceCode.size() <= 32 && data.referenceCode.matches('^[A-Z0-9]{2,10}-[A-Z0-9\\-]+$')
        && data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 120
        && data.phone is string && data.phone.size() >= 6 && data.phone.size() <= 32
        && data.email is string && data.email.size() <= 254
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 80
        && data.showroomId is string && data.showroomId.size() >= 1 && data.showroomId.size() <= 128
        && data.showroomName is string && data.showroomName.size() >= 1 && data.showroomName.size() <= 140
        && data.message is string && data.message.size() >= 5 && data.message.size() <= 3000
        && data.attachmentImage is string && data.attachmentImage.size() <= 400000
        && data.status in ['New', 'Reviewing', 'In Progress', 'Resolved', 'Rejected', 'Closed']
        && (!('priority' in data) || data.priority in ['Low', 'Normal', 'High', 'Urgent'])
        && (!('deleted' in data) || data.deleted is bool)
        && data.adminNote is string && data.adminNote.size() <= 2000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidGreeting(data) {
      return data.keys().hasAll(['useDynamicDate', 'customDateText', 'greetingText', 'dailyMessage', 'specialMessage', 'announcement', 'updatedAt'])
        && data.keys().hasOnly([
          'useDynamicDate', 'customDateText', 'customDateTextEn',
          'greetingText', 'greetingTextEn', 'greeting_bn', 'greeting_en',
          'dailyMessage', 'dailyMessageEn', 'message_bn', 'message_en',
          'specialMessage', 'specialMessageEn', 'special_message_bn', 'special_message_en',
          'announcement', 'announcementEn', 'announcement_bn', 'announcement_en',
          'updatedAt'
        ])
        && data.useDynamicDate is bool
        && data.customDateText is string && data.customDateText.size() <= 120
        && (!('customDateTextEn' in data) || (data.customDateTextEn is string && data.customDateTextEn.size() <= 120))
        && data.greetingText is string && data.greetingText.size() >= 1 && data.greetingText.size() <= 160
        && (!('greetingTextEn' in data) || (data.greetingTextEn is string && data.greetingTextEn.size() <= 160))
        && (!('greeting_bn' in data) || (data.greeting_bn is string && data.greeting_bn.size() <= 160))
        && (!('greeting_en' in data) || (data.greeting_en is string && data.greeting_en.size() <= 160))
        && data.dailyMessage is string && data.dailyMessage.size() >= 1 && data.dailyMessage.size() <= 200
        && (!('dailyMessageEn' in data) || (data.dailyMessageEn is string && data.dailyMessageEn.size() <= 200))
        && (!('message_bn' in data) || (data.message_bn is string && data.message_bn.size() <= 200))
        && (!('message_en' in data) || (data.message_en is string && data.message_en.size() <= 200))
        && data.specialMessage is string && data.specialMessage.size() <= 200
        && (!('specialMessageEn' in data) || (data.specialMessageEn is string && data.specialMessageEn.size() <= 200))
        && (!('special_message_bn' in data) || (data.special_message_bn is string && data.special_message_bn.size() <= 200))
        && (!('special_message_en' in data) || (data.special_message_en is string && data.special_message_en.size() <= 200))
        && data.announcement is string && data.announcement.size() <= 240
        && (!('announcementEn' in data) || (data.announcementEn is string && data.announcementEn.size() <= 240))
        && (!('announcement_bn' in data) || (data.announcement_bn is string && data.announcement_bn.size() <= 240))
        && (!('announcement_en' in data) || (data.announcement_en is string && data.announcement_en.size() <= 240))
        && data.updatedAt is timestamp;
    }

    function isValidGreetingItem(data) {
      return data.keys().hasAll(['id', 'text_bn', 'text_en', 'type', 'active', 'visible', 'display_order', 'updatedAt'])
        && data.keys().hasOnly([
          'id', 'text_bn', 'text_en', 'type', 'active', 'visible', 'display_order',
          'durationMs', 'startDate', 'endDate', 'deleted', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.text_bn is string && data.text_bn.size() <= 240
        && data.text_en is string && data.text_en.size() <= 240
        && data.type in ['greeting', 'welcome', 'announcement', 'rotating']
        && data.active is bool
        && data.visible is bool
        && data.display_order is int && data.display_order >= 0 && data.display_order <= 1000
        && (!('durationMs' in data) || (data.durationMs is int && data.durationMs >= 1000 && data.durationMs <= 60000))
        && (!('startDate' in data) || (data.startDate is string && data.startDate.size() <= 32))
        && (!('endDate' in data) || (data.endDate is string && data.endDate.size() <= 32))
        && (!('deleted' in data) || data.deleted is bool)
        && (!('createdAt' in data) || data.createdAt is timestamp)
        && data.updatedAt is timestamp;
