        )
        && incoming().updatedAt == request.time
        && (
          ('createdAt' in existing()
            && existing().createdAt is timestamp
            && incoming().createdAt == existing().createdAt
            && incoming().diff(existing()).addedKeys().hasOnly([
              'id', 'name', 'nameEn', 'name_bn', 'name_en', 'slug', 'icon',
              'description', 'descriptionEn', 'description_bn', 'description_en',
              'order', 'visible', 'deleted', 'archivedAt', 'seoTitle', 'seoDescription',
              'updatedAt'
            ])
            && incoming().diff(existing()).changedKeys().hasOnly([
              'id', 'name', 'nameEn', 'name_bn', 'name_en', 'slug', 'icon',
              'description', 'descriptionEn', 'description_bn', 'description_en',
              'order', 'visible', 'deleted', 'archivedAt', 'seoTitle', 'seoDescription',
              'updatedAt'
            ]))
          ||
          ((!('createdAt' in existing()) || !(existing().createdAt is timestamp))
            && incoming().createdAt == request.time
            && incoming().diff(existing()).addedKeys().hasOnly([
              'id', 'name', 'nameEn', 'name_bn', 'name_en', 'slug', 'icon',
              'description', 'descriptionEn', 'description_bn', 'description_en',
              'order', 'visible', 'deleted', 'archivedAt', 'seoTitle', 'seoDescription',
              'createdAt', 'updatedAt'
            ])
            && incoming().diff(existing()).changedKeys().hasOnly([
              'id', 'name', 'nameEn', 'name_bn', 'name_en', 'slug', 'icon',
              'description', 'descriptionEn', 'description_bn', 'description_en',
              'order', 'visible', 'deleted', 'archivedAt', 'seoTitle', 'seoDescription',
              'createdAt', 'updatedAt'
            ]))
        );
      allow delete: if hasPermission('categories_manage') && isValidId(occasionId);
    }

    match /products/{productId} {
      allow get: if isValidId(productId);
      allow list: if true;
      allow create: if hasCatalogWritePerm('products_add')
        && isValidId(productId)
        && isValidProduct(incoming())
        && incoming().id == productId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if hasCatalogWritePerm('products_edit')
        && isValidId(productId)
        && isValidProduct(incoming())
        && (
          ('id' in existing() && isValidId(existing().id) && incoming().id == existing().id)
          || ((!('id' in existing()) || !isValidId(existing().id)) && incoming().id == productId)
        )
        && (
          !('createdBy' in existing())
          || !(existing().createdBy is string)
          || existing().createdBy.trim() == ''
          || (('createdBy' in incoming()) && incoming().createdBy == existing().createdBy)
        )
        && incoming().updatedAt == request.time
        && (
          ('createdAt' in existing()
            && existing().createdAt is timestamp
            && incoming().createdAt == existing().createdAt)
          ||
          ((!('createdAt' in existing()) || !(existing().createdAt is timestamp))
            && incoming().createdAt == request.time)
        );
      allow delete: if hasPermission('products_delete') && isValidId(productId);
    }

    match /showrooms/{showroomId} {
      allow get: if isValidId(showroomId);
