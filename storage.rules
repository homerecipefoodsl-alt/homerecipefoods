rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Recruitment candidate photos (JPG/JPEG/PNG, max 2 MB)
    match /job-applications/{applicationId}/photo/{fileName} {
      allow create: if applicationId.matches('^(SN-JOB|HRF)-[0-9]{4}-[A-Z0-9]{4,10}$')
        && request.resource != null
        && request.resource.size <= 2 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|jpg|png)');
      allow read, delete: if request.auth != null
        && request.auth.token.email_verified == true;
      allow update: if false;
    }

    // Recruitment candidate documents (JPG/JPEG/PNG/PDF/DOC/DOCX, max 5 MB)
    match /job-applications/{applicationId}/documents/{fileName} {
      allow create: if applicationId.matches('^(SN-JOB|HRF)-[0-9]{4}-[A-Z0-9]{4,10}$')
        && request.resource != null
        && request.resource.size <= 5 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/(jpeg|jpg|png)')
          || request.resource.contentType == 'application/pdf'
          || request.resource.contentType == 'application/msword'
          || request.resource.contentType == 'application/vnd.openxmlformats-officedocument.wordprocessingml.document'
        );
      allow read, delete: if request.auth != null
        && request.auth.token.email_verified == true;
      allow update: if false;
    }

    function isVerifiedAuthUser() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && ('email' in request.auth.token)
        && request.auth.token.email is string;
    }

    function isPrimarySuperAdmin() {
      return isVerifiedAuthUser()
        && request.auth.token.email.lower() == 'mdmahmudulhashan0@gmail.com';
    }

    // Enforce verified password-based staff identity and honor custom RBAC claims whenever synced
    function isAuthorizedCatalogAdmin() {
      return isPrimarySuperAdmin()
        || (
          isVerifiedAuthUser()
          && request.auth.token.firebase.sign_in_provider == 'password'
          && (!('role' in request.auth.token) || request.auth.token.role in ['super_admin', 'admin', 'manager'])
          && (!('staff_status' in request.auth.token) || request.auth.token.staff_status == 'active')
          && (!('hrf_staff' in request.auth.token) || request.auth.token.hrf_staff == true)
        );
    }

    // Product showcase photos (JPG/JPEG/PNG/WEBP, max 5 MB; public read, authorized catalog admin write)
    match /products/{productId}/{fileName} {
      allow read: if true;
      allow create, update: if isAuthorizedCatalogAdmin()
        && request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|jpg|png|webp)');
      allow delete: if isAuthorizedCatalogAdmin();
    }

    // Category cover photos (JPG/JPEG/PNG/WEBP, max 5 MB; public read, authorized catalog admin write)
    match /categories/{categoryId}/{fileName} {
      allow read: if true;
      allow create, update: if isAuthorizedCatalogAdmin()
        && request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|jpg|png|webp)');
      allow delete: if isAuthorizedCatalogAdmin();
    }

    // Existing CMS / Media Library uploads (authorized catalog admin only)
    match /media/{folder}/{fileName} {
      allow read: if true;
      allow create, update: if isAuthorizedCatalogAdmin()
        && request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|jpg|png|webp|gif)');
      allow delete: if isAuthorizedCatalogAdmin();
    }
  }
}
