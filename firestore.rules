          'tagline', 'taglineBn', 'taglineEn',
          'shortDescriptionBn', 'shortDescriptionEn', 'longDescriptionBn', 'longDescriptionEn',
          'supportOnline', 'supportPhone', 'brandEmail', 'brandAddressBn', 'brandAddressEn',
          'messengerUrl', 'facebookUrl', 'instagramUrl', 'youtubeUrl', 'whatsappUrl',
          'footerTextBn', 'footerTextEn',
          'announcementEnabled', 'announcementBn', 'announcementEn', 'announcementLink',
          'primaryColor', 'accentColor', 'heroSlides', 'defaultLanguage',
          'aiSupportEnabled', 'aiAssistantName', 'aiFallbackMessage', 'aiCustomInstructions',
          'chatSupportHours', 'chatOfflineMessage', 'chatWelcomeMessage', 'chatCategories',
          'complaintCategories', 'complaintRefPrefix', 'complaintTemplates',
          'updatedAt'
        ])
        && data.brandName is string && data.brandName.size() >= 1 && data.brandName.size() <= 100
        && (!('brandNameBn' in data) || (data.brandNameBn is string && data.brandNameBn.size() <= 100))
        && (!('brandNameEn' in data) || (data.brandNameEn is string && data.brandNameEn.size() <= 100))
        && (!('logoUrl' in data) || (data.logoUrl is string && data.logoUrl.size() <= 400000))
        && (!('faviconUrl' in data) || (data.faviconUrl is string && data.faviconUrl.size() <= 400000))
        && data.tagline is string && data.tagline.size() >= 1 && data.tagline.size() <= 200
        && (!('taglineBn' in data) || (data.taglineBn is string && data.taglineBn.size() <= 200))
        && (!('taglineEn' in data) || (data.taglineEn is string && data.taglineEn.size() <= 200))
        && (!('shortDescriptionBn' in data) || (data.shortDescriptionBn is string && data.shortDescriptionBn.size() <= 600))
        && (!('shortDescriptionEn' in data) || (data.shortDescriptionEn is string && data.shortDescriptionEn.size() <= 600))
        && (!('longDescriptionBn' in data) || (data.longDescriptionBn is string && data.longDescriptionBn.size() <= 2000))
        && (!('longDescriptionEn' in data) || (data.longDescriptionEn is string && data.longDescriptionEn.size() <= 2000))
        && data.supportOnline is bool
        && data.supportPhone is string && data.supportPhone.size() >= 5 && data.supportPhone.size() <= 40
        && (!('brandEmail' in data) || (data.brandEmail is string && data.brandEmail.size() <= 254))
        && (!('brandAddressBn' in data) || (data.brandAddressBn is string && data.brandAddressBn.size() <= 300))
        && (!('brandAddressEn' in data) || (data.brandAddressEn is string && data.brandAddressEn.size() <= 300))
        && data.messengerUrl is string && data.messengerUrl.size() <= 300
        && data.facebookUrl is string && data.facebookUrl.size() <= 300
        && data.instagramUrl is string && data.instagramUrl.size() <= 300
        && data.youtubeUrl is string && data.youtubeUrl.size() <= 300
        && (!('whatsappUrl' in data) || (data.whatsappUrl is string && data.whatsappUrl.size() <= 300))
        && (!('footerTextBn' in data) || (data.footerTextBn is string && data.footerTextBn.size() <= 600))
        && (!('footerTextEn' in data) || (data.footerTextEn is string && data.footerTextEn.size() <= 600))
        && (!('announcementEnabled' in data) || data.announcementEnabled is bool)
        && (!('announcementBn' in data) || (data.announcementBn is string && data.announcementBn.size() <= 300))
        && (!('announcementEn' in data) || (data.announcementEn is string && data.announcementEn.size() <= 300))
        && (!('announcementLink' in data) || (data.announcementLink is string && data.announcementLink.size() <= 300))
        && (!('primaryColor' in data) || (data.primaryColor is string && data.primaryColor.size() <= 32))
        && (!('accentColor' in data) || (data.accentColor is string && data.accentColor.size() <= 32))
        && data.heroSlides is list && data.heroSlides.size() <= 6
        && (data.heroSlides.size() == 0 || data.heroSlides[0] is map)
        && (!('defaultLanguage' in data) || data.defaultLanguage in ['both', 'bn', 'en'])
        && (!('aiSupportEnabled' in data) || data.aiSupportEnabled is bool)
        && (!('aiAssistantName' in data) || (data.aiAssistantName is string && data.aiAssistantName.size() >= 1 && data.aiAssistantName.size() <= 80))
        && (!('aiFallbackMessage' in data) || (data.aiFallbackMessage is string && data.aiFallbackMessage.size() >= 1 && data.aiFallbackMessage.size() <= 300))
        && (!('aiCustomInstructions' in data) || (data.aiCustomInstructions is string && data.aiCustomInstructions.size() <= 1000))
        && (!('chatSupportHours' in data) || (data.chatSupportHours is string && data.chatSupportHours.size() <= 160))
        && (!('chatOfflineMessage' in data) || (data.chatOfflineMessage is string && data.chatOfflineMessage.size() <= 400))
        && (!('chatWelcomeMessage' in data) || (data.chatWelcomeMessage is string && data.chatWelcomeMessage.size() <= 500))
        && (!('chatCategories' in data) || isBoundedStringList(data.chatCategories, 12, 80))
        && (!('complaintCategories' in data) || isBoundedStringList(data.complaintCategories, 15, 80))
        && (!('complaintRefPrefix' in data) || (data.complaintRefPrefix is string && data.complaintRefPrefix.size() <= 12))
        && (!('complaintTemplates' in data) || isBoundedStringList(data.complaintTemplates, 15, 400))
        && data.updatedAt is timestamp;
    }

    function isValidHeroBanner(data) {
      return data.keys().hasAll(['id', 'title', 'subtitle', 'ctaLabel', 'ctaLink', 'image', 'updatedAt'])
        && data.keys().hasOnly([
          'id', 'title', 'title_bn', 'title_en', 'subtitle', 'subtitle_bn', 'subtitle_en',
          'displayLanguage', 'ctaLabel', 'ctaLink', 'image', 'mobileImage',
          'order', 'active', 'visible', 'deleted', 'startDate', 'endDate', 'overlayOpacity',
          'status', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
        && data.subtitle is string && data.subtitle.size() <= 400
        && data.ctaLabel is string && data.ctaLabel.size() <= 80
        && data.ctaLink is string && data.ctaLink.size() <= 300
        && data.image is string && data.image.size() >= 1 && data.image.size() <= 500000
        && (!('title_bn' in data) || (data.title_bn is string && data.title_bn.size() <= 200))
        && (!('title_en' in data) || (data.title_en is string && data.title_en.size() <= 200))
        && (!('subtitle_bn' in data) || (data.subtitle_bn is string && data.subtitle_bn.size() <= 400))
        && (!('subtitle_en' in data) || (data.subtitle_en is string && data.subtitle_en.size() <= 400))
        && (!('displayLanguage' in data) || data.displayLanguage in ['both', 'bn', 'en'])
        && (!('order' in data) || (data.order is int && data.order >= 0 && data.order <= 100))
        && (!('active' in data) || data.active is bool)
        && (!('visible' in data) || data.visible is bool)
        && (!('deleted' in data) || data.deleted is bool)
        && (!('startDate' in data) || (data.startDate is string && data.startDate.size() <= 32))
        && (!('endDate' in data) || (data.endDate is string && data.endDate.size() <= 32))
        && data.updatedAt is timestamp;
    }

    function isValidHomepageSection(data) {
      return data.keys().hasAll(['id', 'sectionKey', 'enabled', 'visible', 'display_order', 'title_bn', 'title_en', 'subtitle_bn', 'subtitle_en', 'updatedAt'])
        && data.keys().hasOnly([
          'id', 'sectionKey', 'enabled', 'visible', 'display_order',
          'title_bn', 'title_en', 'subtitle_bn', 'subtitle_en',
          'content_bn', 'content_en', 'ctaTextBn', 'ctaTextEn', 'ctaLink',
          'cta_bn', 'cta_en', 'cta_link', 'backgroundImage', 'status', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.sectionKey in [
          'hero', 'announcement', 'categories', 'featured_products', 'occasion_explorer',
          'popular_products', 'promotional_banner', 'showrooms', 'complaint_and_support'
        ]
        && data.enabled is bool
        && data.visible is bool
        && data.display_order is int && data.display_order >= 0 && data.display_order <= 100
        && data.title_bn is string && data.title_bn.size() <= 200
        && data.title_en is string && data.title_en.size() <= 200
        && data.subtitle_bn is string && data.subtitle_bn.size() <= 400
        && data.subtitle_en is string && data.subtitle_en.size() <= 400
        && (!('ctaTextBn' in data) || (data.ctaTextBn is string && data.ctaTextBn.size() <= 100))
        && (!('ctaTextEn' in data) || (data.ctaTextEn is string && data.ctaTextEn.size() <= 100))
        && (!('ctaLink' in data) || (data.ctaLink is string && data.ctaLink.size() <= 300))
        && (!('cta_bn' in data) || (data.cta_bn is string && data.cta_bn.size() <= 100))
        && (!('cta_en' in data) || (data.cta_en is string && data.cta_en.size() <= 100))
        && (!('cta_link' in data) || (data.cta_link is string && data.cta_link.size() <= 300))
        && (!('status' in data) || data.status in ['draft', 'published', 'archived'])
        && data.updatedAt is timestamp;
    }

    function isValidSeoSettings(data) {
      return data.keys().hasAll(['siteTitle', 'metaDescription', 'metaKeywords', 'ogTitle', 'ogDescription', 'ogImage', 'updatedAt'])
        && data.keys().hasOnly([
          'siteTitle', 'siteTitleBn', 'metaDescription', 'metaKeywords',
          'ogTitle', 'ogDescription', 'ogImage', 'twitterCard',
          'homepageTitle', 'homepageDescription', 'updatedAt'
        ])
        && data.siteTitle is string && data.siteTitle.size() >= 1 && data.siteTitle.size() <= 160
        && data.metaDescription is string && data.metaDescription.size() <= 400
        && data.metaKeywords is string && data.metaKeywords.size() <= 400
        && data.ogTitle is string && data.ogTitle.size() <= 160
        && data.ogDescription is string && data.ogDescription.size() <= 400
        && data.ogImage is string && data.ogImage.size() <= 500000
        && data.updatedAt is timestamp;
    }

    function isValidMediaItem(data) {
      return data.keys().hasAll(['id', 'name', 'folder', 'url', 'mimeType', 'sizeBytes', 'createdAt'])
        && data.keys().hasOnly([
          'id', 'name', 'folder', 'url', 'storagePath', 'mimeType', 'sizeBytes',
          'uploadedByEmail', 'uploadedBy', 'deleted', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 200
        && data.folder in ['Products', 'Categories', 'Hero', 'Showrooms', 'General', 'Branding']
        && data.url is string && data.url.size() >= 1 && data.url.size() <= 500000
        && data.mimeType is string && data.mimeType.size() <= 80
        && data.sizeBytes is int && data.sizeBytes >= 0 && data.sizeBytes <= 50000000
        && (!('deleted' in data) || data.deleted is bool)
        && data.createdAt is timestamp;
    }

    function isValidAiKnowledge(data) {
      return data.keys().hasAll(['id', 'title', 'category', 'active', 'visible', 'order', 'updatedAt'])
        && data.keys().hasOnly([
          'id', 'title', 'category', 'question_bn', 'question_en',
          'answer_bn', 'answer_en', 'content_bn', 'content_en',
          'active', 'visible', 'deleted', 'order', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 80
        && (!('question_bn' in data) || (data.question_bn is string && data.question_bn.size() <= 400))
        && (!('question_en' in data) || (data.question_en is string && data.question_en.size() <= 400))
        && (!('answer_bn' in data) || (data.answer_bn is string && data.answer_bn.size() <= 2000))
        && (!('answer_en' in data) || (data.answer_en is string && data.answer_en.size() <= 2000))
        && (!('content_bn' in data) || (data.content_bn is string && data.content_bn.size() <= 2000))
        && (!('content_en' in data) || (data.content_en is string && data.content_en.size() <= 2000))
        && data.active is bool
        && data.visible is bool
        && data.order is int && data.order >= 0 && data.order <= 1000
        && (!('deleted' in data) || data.deleted is bool)
        && data.updatedAt is timestamp;
    }

    function isValidActivityLog(data) {
      return data.keys().hasAll(['id', 'admin_uid', 'admin_email', 'action', 'module', 'record_id', 'timestamp'])
        && data.keys().hasOnly(['id', 'admin_uid', 'admin_email', 'action', 'module', 'record_id', 'record_label', 'summary', 'timestamp'])
        && isValidId(data.id)
        && data.admin_uid is string && data.admin_uid.size() >= 1 && data.admin_uid.size() <= 128
        && isValidEmailId(data.admin_email)
        && data.action is string && data.action.size() >= 1 && data.action.size() <= 80
        && data.module is string && data.module.size() >= 1 && data.module.size() <= 80
        && data.record_id is string && data.record_id.size() >= 1 && data.record_id.size() <= 128
        && (!('record_label' in data) || (data.record_label is string && data.record_label.size() <= 160))
        && (!('summary' in data) || (data.summary is string && data.summary.size() <= 400))
        && data.timestamp is timestamp;
    }

    function isValidChatSession(data) {
      return data.keys().hasAll([
          'id', 'customerName', 'customerPhone', 'status',
          'assignedAdminEmail', 'assignedAdminName', 'lastMessage', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'customerUid', 'customerName', 'customerPhone', 'category', 'status',
          'assignedAdminEmail', 'assignedAdminName', 'lastMessage', 'createdAt', 'updatedAt'
        ])
        && isValidChatSessionId(data.id)
        && (!('customerUid' in data) || (data.customerUid is string && data.customerUid.size() <= 128))
        && data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 100
        && data.customerPhone is string && data.customerPhone.size() >= 5 && data.customerPhone.size() <= 32
        && (!('category' in data) || (data.category is string && data.category.size() <= 80))
        && data.status in ['waiting', 'active', 'closed']
        && data.assignedAdminEmail is string && data.assignedAdminEmail.size() <= 254
        && data.assignedAdminName is string && data.assignedAdminName.size() <= 120
        && data.lastMessage is string && data.lastMessage.size() <= 500
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidChatMessage(data) {
      return data.keys().hasAll(['id', 'sessionId', 'senderRole', 'senderName', 'text', 'createdAt'])
        && data.keys().hasOnly(['id', 'sessionId', 'customerUid', 'senderRole', 'senderName', 'text', 'createdAt'])
        && isValidId(data.id)
        && isValidChatSessionId(data.sessionId)
        && (!('customerUid' in data) || (data.customerUid is string && data.customerUid.size() <= 128))
        && data.senderRole in ['customer', 'admin', 'system']
        && data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 100
        && data.text is string && data.text.size() >= 1 && data.text.size() <= 2000
        && data.createdAt is timestamp;
    }

    // ==============================================
    // Collection Rules
    // ==============================================

    // Authoritative RBAC Roles Registry (/rbac_roles/{emailKey})
    match /rbac_roles/{emailKey} {
      allow get: if isValidEmailId(emailKey)
        && (isSuperAdmin() || hasPermission('manager_manage') || (hasVerifiedEmail() && authEmail() == emailKey));
      allow list: if isSuperAdmin() || hasPermission('manager_manage');
      allow create: if isValidEmailId(emailKey)
        && isValidRbacRole(incoming())
        && incoming().email == emailKey
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          (isPrimarySuperAdmin()
            && emailKey == 'mdmahmudulhashan0@gmail.com'
            && incoming().role == 'super_admin'
            && incoming().status == 'active')
          ||
          (isPrimarySuperAdmin()
            && emailKey != 'mdmahmudulhashan0@gmail.com'
            && incoming().role in ['super_admin', 'admin', 'manager', 'support_agent'])
          ||
          (isSuperAdmin()
            && emailKey != 'mdmahmudulhashan0@gmail.com'
            && incoming().role in ['admin', 'manager', 'support_agent'])
          ||
          (hasPermission('manager_manage')
            && emailKey != 'mdmahmudulhashan0@gmail.com'
            && incoming().role == 'manager')
        );
      allow update: if isValidEmailId(emailKey)
        && isValidRbacRole(incoming())
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (isSuperAdmin()
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'uid', 'username', 'displayName', 'phone', 'managerId', 'managerTitle',
              'permissions', 'role', 'status', 'addedByEmail', 'createdBy', 'updatedAt', 'lastLoginAt'
            ])
            && (
              (emailKey == 'mdmahmudulhashan0@gmail.com'
                && incoming().role == 'super_admin'
                && incoming().status == 'active')
              ||
              (isPrimarySuperAdmin()
                && emailKey != 'mdmahmudulhashan0@gmail.com'
                && incoming().role in ['super_admin', 'admin', 'manager', 'support_agent'])
              ||
              (emailKey != 'mdmahmudulhashan0@gmail.com'
                && incoming().role in ['admin', 'manager', 'support_agent'])
            ))
          ||
          (hasPermission('manager_manage')
            && emailKey != 'mdmahmudulhashan0@gmail.com'
            && existing().role == 'manager'
            && incoming().role == 'manager'
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'uid', 'username', 'displayName', 'phone', 'managerId', 'managerTitle',
              'permissions', 'status', 'updatedAt'
            ]))
          ||
          (hasVerifiedEmail()
            && authEmail() == emailKey
            && existing().status == 'active'
            && existing().uid == ''
            && incoming().uid == request.auth.uid
            && incoming().role == existing().role
            && incoming().status == existing().status
            && (!('permissions' in existing()) || incoming().permissions == existing().permissions)
            && incoming().diff(existing()).affectedKeys().hasOnly(['uid', 'displayName', 'updatedAt']))
        );
      allow delete: if isSuperAdmin()
        && isValidEmailId(emailKey)
        && emailKey != 'mdmahmudulhashan0@gmail.com';
    }

    // Admin Username-to-Email Lookup (/admin_usernames/{usernameId})
    // Single-document get only (no list enumeration) so /mahmud supports username sign-in securely
    match /admin_usernames/{usernameId} {
      allow get: if isValidId(usernameId);
      allow list: if false;
      allow create, update: if isValidId(usernameId)
        && isValidAdminUsername(incoming())
        && incoming().username == usernameId
        && incoming().updatedAt == request.time
        && (
          isSuperAdmin()
          || (hasPermission('manager_manage') && usernameId != 'mahmud' && incoming().email != 'mdmahmudulhashan0@gmail.com')
          || (isPrimarySuperAdmin() && usernameId == 'mahmud' && incoming().email == 'mdmahmudulhashan0@gmail.com')
        );
      allow delete: if isSuperAdmin()
        && isValidId(usernameId)
        && usernameId != 'mahmud';
    }

    // Registered User Accounts (/users/{userId})
    match /users/{userId} {
      allow get: if isValidId(userId)
        && (isSuperAdmin() || (hasVerifiedEmail() && request.auth.uid == userId));
      allow list: if isSuperAdmin();
      allow create: if hasVerifiedEmail()
        && isValidId(userId)
        && isValidUserAccount(incoming())
        && incoming().uid == userId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && incoming().lastLoginAt == request.time
        && (
          (isPrimarySuperAdmin() && incoming().role in ['super_admin', 'admin', 'manager', 'support_agent', 'customer'])
          ||
          (isSuperAdmin() && incoming().role in ['admin', 'manager', 'support_agent', 'customer'])
          ||
          (request.auth.uid == userId
            && incoming().email == authEmail()
            && (
              (isPrimarySuperAdmin() && incoming().role == 'super_admin' && incoming().status == 'active')
              || (!isPrimarySuperAdmin() && hasActiveRbacDoc() && incoming().role == rbacRole() && incoming().status == 'active')
              || (!isPrimarySuperAdmin() && !hasActiveRbacDoc() && incoming().role == 'customer' && incoming().status == 'active')
            ))
        );
      allow update: if isValidId(userId)
        && isValidUserAccount(incoming())
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (isSuperAdmin()
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName', 'photoUrl', 'phone', 'managerId', 'permissions',
              'role', 'status', 'createdBy', 'updatedAt', 'lastLoginAt'
            ])
            && (
              (existing().email == 'mdmahmudulhashan0@gmail.com'
                && incoming().role == 'super_admin'
                && incoming().status == 'active')
              ||
              (isPrimarySuperAdmin()
                && existing().email != 'mdmahmudulhashan0@gmail.com'
                && incoming().role in ['customer', 'super_admin', 'admin', 'manager', 'support_agent'])
              ||
              (existing().email != 'mdmahmudulhashan0@gmail.com'
                && incoming().role in ['customer', 'admin', 'manager', 'support_agent'])
            ))
          ||
          (hasVerifiedEmail()
            && request.auth.uid == userId
            && incoming().status == existing().status
            && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoUrl', 'role', 'updatedAt', 'lastLoginAt'])
            && (
              (isPrimarySuperAdmin() && incoming().role == 'super_admin')
              || (!isPrimarySuperAdmin() && hasActiveRbacDoc() && incoming().role == rbacRole())
              || (!isPrimarySuperAdmin() && !hasActiveRbacDoc() && incoming().role == 'customer')
            ))
        );
      allow delete: if isSuperAdmin()
        && isValidId(userId)
        && userId != request.auth.uid
        && existing().email != 'mdmahmudulhashan0@gmail.com';
    }

    // Admin Records (/admins/{adminUid})
    match /admins/{adminUid} {
      allow get: if isValidId(adminUid)
        && (isSuperAdmin() || hasPermission('manager_manage') || (hasVerifiedEmail() && request.auth.uid == adminUid));
      allow list: if isSuperAdmin() || hasPermission('manager_manage');
      allow create: if isValidId(adminUid)
        && isValidAdminRecord(incoming())
        && incoming().uid == adminUid
        && (
          (isPrimarySuperAdmin() && incoming().role in ['super_admin', 'admin', 'manager', 'support_agent'])
          || (isSuperAdmin() && incoming().role in ['admin', 'manager', 'support_agent'] && incoming().email != 'mdmahmudulhashan0@gmail.com')
          || (hasPermission('manager_manage') && incoming().role == 'manager' && incoming().email != 'mdmahmudulhashan0@gmail.com')
          || (isPrimarySuperAdmin() && adminUid == request.auth.uid && incoming().role == 'super_admin')
          || (hasActiveRbacDoc()
            && adminUid == request.auth.uid
            && incoming().email == authEmail()
            && incoming().role == rbacRole()
            && incoming().active == true)
        );
      allow update: if isValidId(adminUid)
        && isValidAdminRecord(incoming())
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && (
          (isPrimarySuperAdmin() && incoming().role in ['super_admin', 'admin', 'manager', 'support_agent'])
          || (isSuperAdmin()
            && existing().email != 'mdmahmudulhashan0@gmail.com'
            && incoming().role in ['admin', 'manager', 'support_agent'])
          || (hasPermission('manager_manage')
            && existing().role == 'manager'
            && incoming().role == 'manager'
            && existing().email != 'mdmahmudulhashan0@gmail.com')
          || (isPrimarySuperAdmin() && adminUid == request.auth.uid && incoming().role == 'super_admin')
          || (hasActiveRbacDoc()
            && adminUid == request.auth.uid
            && incoming().role == existing().role
            && incoming().active == existing().active
            && (!('permissions' in existing()) || incoming().permissions == existing().permissions))
        );
      allow delete: if isSuperAdmin()
        && isValidId(adminUid)
        && adminUid != request.auth.uid
        && existing().email != 'mdmahmudulhashan0@gmail.com';
    }

    // Public Catalog Showcase (Granular permission enforcement)
    match /categories/{categoryId} {
      allow get: if isValidId(categoryId);
      allow list: if true;
      allow create: if hasPermission('categories_manage')
        && isValidId(categoryId)
        && isValidCategory(incoming())
        && incoming().id == categoryId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if hasPermission('categories_manage')
        && isValidId(categoryId)
        && isValidCategory(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'nameEn', 'name_bn', 'name_en', 'slug', 'icon',
          'description', 'descriptionEn', 'description_bn', 'description_en',
          'image', 'order', 'visible', 'deleted', 'archivedAt', 'seoTitle', 'seoDescription',
          'updatedAt'
        ]);
      allow delete: if hasPermission('categories_manage') && isValidId(categoryId);
    }

    match /occasions/{occasionId} {
      allow get: if isValidId(occasionId);
      allow list: if true;
      allow create: if hasPermission('categories_manage')
        && isValidId(occasionId)
        && isValidOccasion(incoming())
        && incoming().id == occasionId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if hasPermission('categories_manage')
        && isValidId(occasionId)
        && isValidOccasion(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'nameEn', 'name_bn', 'name_en', 'slug', 'icon',
          'description', 'descriptionEn', 'description_bn', 'description_en',
          'order', 'visible', 'deleted', 'archivedAt', 'seoTitle', 'seoDescription',
          'updatedAt'
        ]);
      allow delete: if hasPermission('categories_manage') && isValidId(occasionId);
    }

    match /products/{productId} {
      allow get: if isValidId(productId);
      allow list: if true;
      allow create: if hasPermission('products_add')
        && isValidId(productId)
        && isValidProduct(incoming())
        && incoming().id == productId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if hasPermission('products_edit')
        && isValidId(productId)
        && isValidProduct(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'nameEn', 'name_bn', 'name_en', 'slug',
          'category', 'categoryName', 'categoryNameEn', 'productType',
          'price', 'old_price', 'discount', 'price_label', 'priceUnit',
          'shortDescription', 'shortDescriptionEn', 'short_description_bn', 'short_description_en',
          'description', 'descriptionEn', 'description_bn', 'description_en',
          'images', 'ingredients', 'ingredients_bn', 'ingredients_en', 'sizes', 'weight', 'occasions', 'showrooms',
          'availability', 'importantNotes', 'featured', 'popular',
          'visible', 'deleted', 'status', 'display_order', 'archivedAt', 'seoTitle', 'seoDescription', 'seoImage',
          'updatedAt'
        ]);
      allow delete: if hasPermission('products_delete') && isValidId(productId);
    }

    match /showrooms/{showroomId} {
      allow get: if isValidId(showroomId);
      allow list: if true;
      allow create: if hasPermission('showrooms_manage')
        && isValidId(showroomId)
        && isValidShowroom(incoming())
        && incoming().id == showroomId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if hasPermission('showrooms_manage')
        && isValidId(showroomId)
        && isValidShowroom(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'nameEn', 'name_bn', 'name_en',
          'area', 'areaEn', 'address', 'addressEn', 'address_bn', 'address_en',
          'description', 'descriptionEn', 'description_bn', 'description_en',
          'phone', 'alternate_phone', 'email',
          'openingHours', 'openingHoursEn', 'opening_time', 'closing_time', 'weekly_holiday',
          'mapUrl', 'lat', 'lng', 'images', 'available_categories', 'available_products',
          'isMain', 'visible', 'deleted', 'display_order', 'archivedAt', 'seoTitle', 'seoDescription',
          'updatedAt'
        ]);
      allow delete: if hasPermission('showrooms_manage') && isValidId(showroomId);
    }

    match /greetings/{greetingId} {
      allow get: if isValidId(greetingId);
      allow list: if true;
      allow create: if hasPermission('banners_manage')
        && isValidId(greetingId)
        && ((greetingId == 'daily' && isValidGreeting(incoming()))
          || (greetingId != 'daily' && isValidGreetingItem(incoming())))
        && incoming().updatedAt == request.time;
      allow update: if hasPermission('banners_manage')
        && isValidId(greetingId)
        && incoming().updatedAt == request.time
        && (
          (greetingId == 'daily' && isValidGreeting(incoming())
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'useDynamicDate', 'customDateText', 'customDateTextEn',
              'greetingText', 'greetingTextEn', 'greeting_bn', 'greeting_en',
              'dailyMessage', 'dailyMessageEn', 'message_bn', 'message_en',
              'specialMessage', 'specialMessageEn', 'special_message_bn', 'special_message_en',
              'announcement', 'announcementEn', 'announcement_bn', 'announcement_en',
              'updatedAt'
            ]))
          ||
          (greetingId != 'daily' && isValidGreetingItem(incoming())
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'text_bn', 'text_en', 'type', 'active', 'visible', 'display_order',
              'durationMs', 'startDate', 'endDate', 'deleted', 'updatedAt'
            ]))
        );
      allow delete: if hasPermission('banners_manage') && isValidId(greetingId) && greetingId != 'daily';
    }

    match /hero_banners/{bannerId} {
      allow get: if isValidId(bannerId);
      allow list: if true;
      allow create: if hasPermission('banners_manage')
        && isValidId(bannerId)
        && isValidHeroBanner(incoming())
        && incoming().id == bannerId
        && incoming().updatedAt == request.time;
      allow update: if hasPermission('banners_manage')
        && isValidId(bannerId)
        && isValidHeroBanner(incoming())
        && incoming().id == existing().id
        && incoming().updatedAt == request.time;
      allow delete: if hasPermission('banners_manage') && isValidId(bannerId);
    }

    match /homepage_sections/{sectionId} {
      allow get: if isValidId(sectionId);
      allow list: if true;
      allow create: if hasPermission('banners_manage')
        && isValidId(sectionId)
        && isValidHomepageSection(incoming())
        && incoming().id == sectionId
        && incoming().updatedAt == request.time;
      allow update: if hasPermission('banners_manage')
        && isValidId(sectionId)
        && isValidHomepageSection(incoming())
        && incoming().id == existing().id
        && incoming().updatedAt == request.time;
      allow delete: if isSuperAdmin() && isValidId(sectionId);
    }

    // Site Settings (Tiered: Super Admin / settings_view = all, banners_manage = heroSlides only, chat_manage = supportOnline only)
    match /site_settings/{settingId} {
      allow get: if isValidId(settingId);
      allow list: if true;
      allow create: if isSuperAdmin()
        && isValidId(settingId)
        && isValidSiteSettings(incoming())
        && incoming().updatedAt == request.time;
      allow update: if isValidId(settingId)
        && isValidSiteSettings(incoming())
        && incoming().updatedAt == request.time
        && (
          ((isSuperAdmin() || hasPermission('settings_view')) && incoming().diff(existing()).affectedKeys().hasOnly([
            'brandName', 'brandNameBn', 'brandNameEn', 'logoUrl', 'faviconUrl',
            'tagline', 'taglineBn', 'taglineEn',
            'shortDescriptionBn', 'shortDescriptionEn', 'longDescriptionBn', 'longDescriptionEn',
            'supportOnline', 'supportPhone', 'brandEmail', 'brandAddressBn', 'brandAddressEn',
            'messengerUrl', 'facebookUrl', 'instagramUrl', 'youtubeUrl', 'whatsappUrl',
            'footerTextBn', 'footerTextEn',
            'announcementEnabled', 'announcementBn', 'announcementEn', 'announcementLink',
            'primaryColor', 'accentColor', 'heroSlides', 'defaultLanguage',
            'aiSupportEnabled', 'aiAssistantName', 'aiFallbackMessage', 'aiCustomInstructions',
            'chatSupportHours', 'chatOfflineMessage', 'chatWelcomeMessage', 'chatCategories',
            'complaintCategories', 'complaintRefPrefix', 'complaintTemplates',
            'updatedAt'
          ]))
          ||
          (hasPermission('banners_manage') && settingId == 'main' && incoming().diff(existing()).affectedKeys().hasOnly([
            'heroSlides', 'updatedAt'
          ]))
          ||
          (hasPermission('chat_manage') && settingId == 'main' && incoming().diff(existing()).affectedKeys().hasOnly([
            'supportOnline', 'updatedAt'
          ]))
        );
      allow delete: if isSuperAdmin() && isValidId(settingId);
    }

    match /seo_settings/{settingId} {
      allow get: if isValidId(settingId);
      allow list: if true;
      allow create, update: if (isSuperAdmin() || hasPermission('seo_manage'))
        && isValidId(settingId)
        && isValidSeoSettings(incoming())
        && incoming().updatedAt == request.time;
      allow delete: if isSuperAdmin() && isValidId(settingId);
    }

    match /media/{mediaId} {
      allow get: if isValidId(mediaId);
      allow list: if true;
      allow create: if hasPermission('banners_manage')
        && isValidId(mediaId)
        && isValidMediaItem(incoming())
        && incoming().id == mediaId
        && incoming().createdAt == request.time;
      allow update: if hasPermission('banners_manage')
        && isValidId(mediaId)
        && isValidMediaItem(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'folder', 'deleted', 'updatedAt']);
      allow delete: if isSuperAdmin() && isValidId(mediaId);
    }

    match /ai_knowledge/{entryId} {
      allow get: if isValidId(entryId);
      allow list: if true;
      allow create: if (hasPermission('banners_manage') || hasPermission('chat_manage'))
        && isValidId(entryId)
        && isValidAiKnowledge(incoming())
        && incoming().id == entryId
        && incoming().updatedAt == request.time;
      allow update: if (hasPermission('banners_manage') || hasPermission('chat_manage'))
        && isValidId(entryId)
        && isValidAiKnowledge(incoming())
        && incoming().id == existing().id
        && incoming().updatedAt == request.time;
      allow delete: if (hasPermission('banners_manage') || hasPermission('chat_manage')) && isValidId(entryId);
    }

    // Strictly Private Complaints Box (Super Admin + Support Agent + submitter own UID only)
    match /complaints/{complaintId} {
      allow get: if isValidId(complaintId) && (
        isSupportStaff()
        || (hasVerifiedEmail() && 'submittedByUid' in existing() && existing().submittedByUid != '' && existing().submittedByUid == request.auth.uid)
      );
      allow list: if isSupportStaff()
        || (hasVerifiedEmail() && resource.data.submittedByUid == request.auth.uid);
      allow create: if isValidId(complaintId)
        && isValidComplaint(incoming())
        && incoming().id == complaintId
        && incoming().status == 'New'
        && incoming().adminNote == ''
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          (!isSignedIn() && (!('submittedByUid' in incoming()) || incoming().submittedByUid == ''))
          || (isSignedIn() && 'submittedByUid' in incoming() && incoming().submittedByUid == request.auth.uid)
        );
      allow update: if isSupportStaff()
        && isValidId(complaintId)
        && isValidComplaint(incoming())
        && (existing().status != 'Closed' || isSuperAdmin())
        && incoming().id == existing().id
        && incoming().referenceCode == existing().referenceCode
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'priority', 'adminNote', 'updatedAt']);
      allow delete: if isSuperAdmin() && isValidId(complaintId);
    }

    // Live Support Chat Sessions & Messages (Super Admin + Support Agent + owning customer only)
    match /chat_sessions/{sessionId} {
      allow get: if isSupportStaff()
        || (isValidChatSessionId(sessionId)
          && (!('customerUid' in existing()) || existing().customerUid == '' || (isSignedIn() && existing().customerUid == request.auth.uid)));
      allow list: if isSupportStaff();
      allow create: if isValidChatSessionId(sessionId)
        && isValidChatSession(incoming())
        && incoming().id == sessionId
        && incoming().status == 'waiting'
        && incoming().assignedAdminEmail == ''
        && incoming().assignedAdminName == ''
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          (!isSignedIn() && (!('customerUid' in incoming()) || incoming().customerUid == ''))
          || (isSignedIn() && 'customerUid' in incoming() && incoming().customerUid == request.auth.uid)
        );
      allow update: if isValidChatSessionId(sessionId)
        && isValidChatSession(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (isSupportStaff() && incoming().diff(existing()).affectedKeys().hasOnly([
            'status', 'assignedAdminEmail', 'assignedAdminName', 'lastMessage', 'updatedAt'
          ]))
          ||
          (existing().status != 'closed'
            && (!('customerUid' in existing()) || existing().customerUid == '' || (isSignedIn() && existing().customerUid == request.auth.uid))
            && (incoming().status == existing().status || incoming().status == 'closed')
            && incoming().diff(existing()).affectedKeys().hasOnly(['lastMessage', 'status', 'updatedAt']))
        );
      allow delete: if isSuperAdmin() && isValidChatSessionId(sessionId);

      match /messages/{messageId} {
        allow get: if isSupportStaff()
          || (isValidChatSessionId(sessionId)
            && isValidId(messageId)
            && (!('customerUid' in existing()) || existing().customerUid == '' || (isSignedIn() && existing().customerUid == request.auth.uid)));
        allow list: if isSupportStaff()
          || (isValidChatSessionId(sessionId)
            && resource.data.sessionId == sessionId
            && (!('customerUid' in resource.data) || resource.data.customerUid == '' || (isSignedIn() && resource.data.customerUid == request.auth.uid)));
        allow create: if isValidChatSessionId(sessionId)
          && isValidId(messageId)
          && isValidChatMessage(incoming())
          && incoming().id == messageId
          && incoming().sessionId == sessionId
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/chat_sessions/$(sessionId))
          && get(/databases/$(database)/documents/chat_sessions/$(sessionId)).data.status != 'closed'
          && (
            isSupportStaff()
            || (incoming().senderRole == 'customer'
              && (
                !('customerUid' in get(/databases/$(database)/documents/chat_sessions/$(sessionId)).data)
                || get(/databases/$(database)/documents/chat_sessions/$(sessionId)).data.customerUid == ''
                || (isSignedIn() && get(/databases/$(database)/documents/chat_sessions/$(sessionId)).data.customerUid == request.auth.uid)
              ))
          );
        allow update: if false;
        allow delete: if isSuperAdmin() && isValidChatSessionId(sessionId) && isValidId(messageId);
      }
    }

    // Immutable Admin Activity Audit Logs (Super Admin + dashboard/reports staff reads, active staff creates own log entry)
    match /activity_logs/{logId} {
      allow get: if isValidId(logId) && (isSuperAdmin() || hasPermission('reports_view') || hasPermission('dashboard_view'));
      allow list: if isSuperAdmin() || hasPermission('reports_view') || hasPermission('dashboard_view');
      allow create: if isValidId(logId)
        && hasActiveRbacDoc()
        && isValidActivityLog(incoming())
        && incoming().id == logId
        && incoming().admin_uid == request.auth.uid
        && incoming().timestamp == request.time;
      allow update, delete: if false;
    }
  }
}
