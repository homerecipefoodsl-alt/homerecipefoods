{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "home-recipe-foods",
  "main": "worker/index.ts",
  "compatibility_date": "2025-04-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/robots.txt",
      "/sitemap.xml"
    ]
  },
  "vars": {
    "APP_URL": "https://home-recipe-foods.workers.dev"
  }
}
