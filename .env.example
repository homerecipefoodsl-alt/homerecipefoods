# ==============================================================================
# SERVER-SIDE PRIVATE SECRETS (NEVER expose to frontend / never commit real values)
# Set in AI Studio Secrets or Cloudflare Worker Secrets (`wrangler secret put`)
# ==============================================================================
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
# Optional: Firebase Service Account JSON (set via Cloudflare `wrangler secret put` or server env, NEVER in frontend/git)
FIREBASE_SERVICE_ACCOUNT_JSON=""

# Cloudflare R2 Object Storage (Used automatically via PRODUCT_IMAGES binding on Cloudflare Workers;
# optional S3 API credentials below enable R2 uploads from local dev / AI Studio preview server)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="home-recipe-product-images"
R2_PUBLIC_URL=""

# ==============================================================================
# PUBLIC FRONTEND FIREBASE WEB APP CONFIG (Optional overrides)
# Defaults automatically load from ./firebase-applet-config.json
# Connected Project: ai-studio-applet-webapp-e4b0f
# Firestore Database: ai-studio-8e160dd1-e90f-4eac-89d5-fbd11fce8ac3
# ==============================================================================
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID="ai-studio-applet-webapp-e4b0f"
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_DATABASE_URL=""
VITE_FIREBASE_FIRESTORE_DATABASE_ID="ai-studio-8e160dd1-e90f-4eac-89d5-fbd11fce8ac3"
